    {
      "type": "object",
      "properties": {
        "v": {
          "const": 0
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "epoch": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "const": "make_term"
        },
        "smt2": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "v",
        "id",
        "epoch",
        "op",
        "smt2"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 0
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "epoch": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "const": "instantiate"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "proposal_id": {
                "type": "string",
                "minLength": 1
              },
              "proposal": {
                "$ref": "#/$defs/proposal"
              }
