            "additionalProperties": false
          }
        }
      },
      "required": [
        "v",
        "id",
        "epoch",
        "op",
        "items"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 0
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "epoch": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "const": "search"
        },
