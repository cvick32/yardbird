      "properties": {
        "v": {
          "const": 0
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "epoch": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "const": "snapshot"
        }
      },
      "required": [
        "v",
        "id",
        "epoch",
        "op"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 0
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "epoch": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "const": "inspect"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "v",
        "id",
        "epoch",
        "op",
        "ref"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 0
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "epoch": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "const": "expand_action"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "work": {
          "type": "integer",
          "minimum": 1
