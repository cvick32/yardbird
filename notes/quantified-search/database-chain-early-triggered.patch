+    #[test]
+    fn guided_conflict_prefix_preserves_fallback_and_short_dependency_bursts() {
+        for step in [0, 7] {
+            let mut policy = DefaultEffort::default().with_countermodel_refinement(true);
+            policy.observe(&EffortEvent::BeginPass {
+                model: 1,
+                depth: 3,
+                refinement_step: step,
+            });
+            let kinds = [
+                OperationKind::CountermodelCandidates,
+                OperationKind::Binder(SearchPhase::TriggeredConflicts),
+                OperationKind::DiscoverDependencies,
+                OperationKind::Binder(SearchPhase::Witnesses),
+            ];
+            let operations = kinds
+                .into_iter()
+                .enumerate()
+                .map(|(index, kind)| EffortOperation {
+                    id: OperationId {
+                        model: 1,
+                        offer: 1,
+                        index,
+                    },
+                    kind,
+                    description: String::new(),
+                })
+                .collect::<Vec<_>>();
+            let context = EffortContext {
+                model: 1,
+                graph_version: 0,
+                depth: 3,
+                refinement_step: step,
+                pending_instances: 0,
+                operations: &operations,
+            };
+            let choose = |policy: &mut DefaultEffort| {
+                let EffortDecision::Execute { operation, .. } = policy.choose(&context) else {
+                    panic!("fallback must remain available");
+                };
+                operations
+                    .iter()
+                    .find(|op| op.id == operation)
+                    .unwrap()
+                    .kind
+            };
+            assert_eq!(choose(&mut policy), kinds[0]);
+            policy.observe(&EffortEvent::Completed {
+                operation: kinds[0],
+                report: &WorkReport::default(),
+            });
+            if step == 7 {
+                // The existing periodic fallback skips dependency discovery too,
+                // ensuring witness search cannot be starved by the prefix.
+                assert_eq!(choose(&mut policy), kinds[3]);
+                continue;
+            }
+            assert_eq!(choose(&mut policy), kinds[1]);
+            policy.observe(&EffortEvent::Completed {
+                operation: kinds[1],
+                report: &WorkReport::default(),
+            });
+            for _ in 0..2 {
+                assert_eq!(choose(&mut policy), kinds[2]);
+                policy.observe(&EffortEvent::Completed {
+                    operation: kinds[2],
+                    report: &WorkReport {
+                        continuable: true,
+                        budget_exhausted: true,
+                        ..Default::default()
+                    },
+                });
+            }
+            assert_eq!(choose(&mut policy), kinds[3]);
