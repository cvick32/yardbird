(declare-sort node 0)
(declare-sort quorum 0)
(declare-fun member (node quorum) Bool)
(declare-fun lt (quorum quorum) Bool)
(declare-fun q () quorum)
(declare-fun a () (Array Int Int))
(assert (forall ((x quorum)) (not (lt x x))))
(assert (forall ((x quorum)) (exists ((n node)) (member n x))))
(define-fun init () Bool (! (forall ((i Int)) (= (select a i) 0)) :init true))
(define-fun trans () Bool (! true :trans true))
(define-fun prop () Bool (! (and
  (not (lt q q))
  (= (select (store a 1 7) 1) 7)
  (= (select a 0) 0)) :invar-property 0))
