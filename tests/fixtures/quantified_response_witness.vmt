; A known request/response pair supplies the existential request witness.
(declare-sort request 0)
(declare-sort response 0)
(declare-fun matches (request response) Bool)
(declare-fun chosen () request)
(declare-fun chosen_next () request)
(declare-fun reply () response)
(declare-fun reply_next () response)
(define-fun .chosen () request (! chosen :next chosen_next))
(define-fun .reply () response (! reply :next reply_next))
(define-fun init () Bool (! (matches chosen reply) :init true))
(define-fun trans () Bool
  (! (and (= chosen_next chosen) (= reply_next reply)) :trans true))
(define-fun prop () Bool
  (! (exists ((r request)) (matches r reply)) :invar-property 0))
