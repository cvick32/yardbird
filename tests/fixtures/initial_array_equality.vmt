; Multi-Paxos regression: a decision requires a quorum vote, but the four-level
; vote array is initially constant false and no action can write a vote.
(declare-sort node 0)
(declare-sort quorum 0)
(declare-fun member (node quorum) Bool)
(declare-fun chosen () quorum)
(declare-fun chosen_next () quorum)
(declare-fun slot () Int)
(declare-fun slot_next () Int)
(declare-fun votes () (Array node (Array Int (Array Int (Array Int Bool)))))
(declare-fun votes_next () (Array node (Array Int (Array Int (Array Int Bool)))))
(declare-fun decisions () (Array Int Bool))
(declare-fun decisions_next () (Array Int Bool))
(define-fun .chosen () quorum (! chosen :next chosen_next))
(define-fun .slot () Int (! slot :next slot_next))
(define-fun .votes () (Array node (Array Int (Array Int (Array Int Bool)))) (! votes :next votes_next))
(define-fun .decisions () (Array Int Bool) (! decisions :next decisions_next))
(declare-fun decide () Bool)
(declare-fun idle () Bool)
(define-fun .decide () Bool (! decide :action 0))
(define-fun .idle () Bool (! idle :action 0))
(assert (forall ((q quorum)) (exists ((n node)) (member n q))))
(define-fun init () Bool (! (and
  (= votes ((as const (Array node (Array Int (Array Int (Array Int Bool)))))
    ((as const (Array Int (Array Int (Array Int Bool))))
      ((as const (Array Int (Array Int Bool)))
        ((as const (Array Int Bool)) false)))))
  (= decisions ((as const (Array Int Bool)) false))) :init true))
(define-fun trans () Bool (! (and
  (= votes_next votes) (= chosen_next chosen)
  (=> decide (and (= decisions_next (store decisions 0 true))
    (forall ((n node)) (=> (member n chosen)
      (select (select (select (select votes n) slot) 0) 1)))))
  (=> idle (= decisions_next decisions))
  (or decide idle) (not (and decide idle))) :trans true))
(define-fun prop () Bool (! (not (select decisions 0)) :invar-property 0))
