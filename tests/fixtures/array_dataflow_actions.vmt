(declare-fun a () (Array Int Int))
(declare-fun a_next () (Array Int Int))
(define-fun .a () (Array Int Int) (! a :next a_next))
(declare-fun b () (Array Int Int))
(declare-fun b_next () (Array Int Int))
(define-fun .b () (Array Int Int) (! b :next b_next))
(declare-fun send () Bool)
(define-fun .send () Bool (! send :action 0))
(declare-fun idle () Bool)
(define-fun .idle () Bool (! idle :action 0))
(declare-fun choose () Bool)
(declare-fun choose_next () Bool)
(define-fun .choose () Bool (! choose :next choose_next))
(declare-fun witness ((Array Int Int)) Int)
(define-fun init () Bool (! true :init true))
(define-fun trans () Bool (!
  (and (=> send (= a_next (ite choose (store a 1 10) (store a 2 20))))
       (=> idle (= a_next a)) (= b_next b)
       (or send idle) (or (not send) (not idle))) :trans true))
(define-fun prop () Bool (! (= (select b 0) 0) :invar-property 0))
