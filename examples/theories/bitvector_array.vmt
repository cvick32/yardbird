; Safe: updates at index 1 preserve index 0. Both index and value are bitvectors.
(declare-fun a () (Array (_ BitVec 8) (_ BitVec 16)))
(declare-fun an () (Array (_ BitVec 8) (_ BitVec 16)))
(define-fun .a () (Array (_ BitVec 8) (_ BitVec 16)) (! a :next an))
(define-fun init () Bool (!
  (forall ((i (_ BitVec 8))) (= (select a i) #x0000)) :init true))
(define-fun trans () Bool (! (= an (store a #x01 (bvadd (select a #x01) #x0001))) :trans true))
(define-fun prop () Bool (! (= (select a #x00) #x0000) :invar-property 0))
