; Safe: signed/unsigned edge cases at 8-bit minimum signed value (unsigned 128).
(declare-fun x () (_ BitVec 8))
(declare-fun xn () (_ BitVec 8))
(define-fun .x () (_ BitVec 8) (! x :next xn))
(define-fun init () Bool (! (= x #x80) :init true))
(define-fun trans () Bool (! (= xn x) :trans true))
(define-fun prop () Bool (! (and
  (= (bvadd x x) #x00) (= (bvsub x #x01) #x7f) (= (bvmul x #x02) #x00)
  (= (bvand x #x0f) #x00) (= (bvor x #x0f) #x8f) (= (bvxor x #xff) #x7f)
  (= (bvnot x) #x7f) (= (bvneg x) #x80)
  (= (bvshl x #x01) #x00) (= (bvlshr x #x01) #x40) (= (bvashr x #x01) #xc0)
  (= (bvudiv x #x03) #x2a) (= (bvurem x #x03) #x02)
  (= (bvsdiv x #x03) #xd6) (= (bvsrem x #x03) #xfe) (= (bvsmod x #x03) #x01)
  (= (bvudiv x #x00) #xff) (= (bvurem x #x00) x)
  (= (bvsdiv x #xff) x)
  (= (bvcomp x #x80) #b1) (= (bvcomp x #x00) #b0)
  (bvule x #x80) (bvuge x #x80) (bvult x #xff) (bvugt x #x00)
  (bvsle x #x80) (bvsge x #x80) (bvslt x #x00) (bvsgt #x00 x)
) :invar-property 0))
