                (select (select (select s_vote q_36_s_N) q_33_s_R) q_34_s_V))))))
      (forall ((q_14_s_X s_round)) (select (select s_le q_14_s_X) q_14_s_X))
      (forall ((q_15_s_X s_round) (q_16_s_Y s_round) (q_17_s_Z s_round))
        (=>
          (and (select (select s_le q_15_s_X) q_16_s_Y) (select (select s_le q_16_s_Y) q_17_s_Z))
          (select (select s_le q_15_s_X) q_17_s_Z)))
      (forall ((q_18_s_X s_round) (q_19_s_Y s_round))
        (=>
          (and (select (select s_le q_18_s_X) q_19_s_Y) (select (select s_le q_19_s_Y) q_18_s_X))
          (= q_18_s_X q_19_s_Y)))
      (forall ((q_20_s_X s_round) (q_21_s_Y s_round))
        (or (select (select s_le q_20_s_X) q_21_s_Y) (select (select s_le q_21_s_Y) q_20_s_X)))
      (forall ((q_22_s_Q1 s_quorum_5f_c) (q_23_s_Q2 s_quorum_5f_c))
        (exists ((q_24_s_N s_node))
          (and
            (select (select s_member_5f_c q_24_s_N) q_22_s_Q1)
            (select (select s_member_5f_c q_24_s_N) q_23_s_Q2))))
      (forall ((q_25_s_Q1 s_quorum_5f_c) (q_26_s_Q2 s_quorum_5f_f) (q_27_s_Q3 s_quorum_5f_f))
        (exists ((q_28_s_N s_node))
          (and
            (select (select s_member_5f_c q_28_s_N) q_25_s_Q1)
            (select (select s_member_5f_f q_28_s_N) q_26_s_Q2)
            (select (select s_member_5f_f q_28_s_N) q_27_s_Q3))))
      (forall ((q_29_s_R s_round) (q_30_s_V s_value) (q_31_s_Q s_quorum_5f_c))
        (=
          (select (select (select s_choosable_5f_c_next q_29_s_R) q_30_s_V) q_31_s_Q)
          (forall ((q_32_s_N s_node))
            (=>
              (select (select s_member_5f_c q_32_s_N) q_31_s_Q)
              (or
                (not (select (select s_left_5f_round_next q_32_s_N) q_29_s_R))
                (select (select (select s_vote_next q_32_s_N) q_29_s_R) q_30_s_V))))))
      (forall ((q_33_s_R s_round) (q_34_s_V s_value) (q_35_s_Q s_quorum_5f_f))
        (=
          (select (select (select s_choosable_5f_f_next q_33_s_R) q_34_s_V) q_35_s_Q)
          (forall ((q_36_s_N s_node))
            (=>
              (select (select s_member_5f_f q_36_s_N) q_35_s_Q)
              (or
                (not (select (select s_left_5f_round_next q_36_s_N) q_33_s_R))
                (select (select (select s_vote_next q_36_s_N) q_33_s_R) q_34_s_V)))))))
    :trans
    true))
(define-fun property () Bool
  (!
    (forall ((q_247_s_R1 s_round) (q_248_s_V1 s_value) (q_249_s_R2 s_round) (q_250_s_V2 s_value))
      (=>
        (and
          (select (select s_decision q_247_s_R1) q_248_s_V1)
          (select (select s_decision q_249_s_R2) q_250_s_V2))
        (= q_248_s_V1 q_250_s_V2)))
    :invar-property
    0))
