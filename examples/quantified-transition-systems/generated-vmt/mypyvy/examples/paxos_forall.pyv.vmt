      (= s_le_next s_le)
      (= s_member_next s_member)
      (forall ((q_13_s_X s_round)) (select (select s_le q_13_s_X) q_13_s_X))
      (forall ((q_14_s_X s_round) (q_15_s_Y s_round) (q_16_s_Z s_round))
        (=>
          (and (select (select s_le q_14_s_X) q_15_s_Y) (select (select s_le q_15_s_Y) q_16_s_Z))
          (select (select s_le q_14_s_X) q_16_s_Z)))
      (forall ((q_17_s_X s_round) (q_18_s_Y s_round))
        (=>
          (and (select (select s_le q_17_s_X) q_18_s_Y) (select (select s_le q_18_s_Y) q_17_s_X))
          (= q_17_s_X q_18_s_Y)))
      (forall ((q_19_s_X s_round) (q_20_s_Y s_round))
        (or (select (select s_le q_19_s_X) q_20_s_Y) (select (select s_le q_20_s_Y) q_19_s_X)))
      (forall ((q_21_s_Q1 s_quorum) (q_22_s_Q2 s_quorum))
        (exists ((q_23_s_N s_node))
          (and
            (select (select s_member q_23_s_N) q_21_s_Q1)
            (select (select s_member q_23_s_N) q_22_s_Q2))))
      (forall ((q_13_s_X s_round)) (select (select s_le q_13_s_X) q_13_s_X))
      (forall ((q_14_s_X s_round) (q_15_s_Y s_round) (q_16_s_Z s_round))
        (=>
          (and (select (select s_le q_14_s_X) q_15_s_Y) (select (select s_le q_15_s_Y) q_16_s_Z))
          (select (select s_le q_14_s_X) q_16_s_Z)))
      (forall ((q_17_s_X s_round) (q_18_s_Y s_round))
        (=>
          (and (select (select s_le q_17_s_X) q_18_s_Y) (select (select s_le q_18_s_Y) q_17_s_X))
          (= q_17_s_X q_18_s_Y)))
      (forall ((q_19_s_X s_round) (q_20_s_Y s_round))
        (or (select (select s_le q_19_s_X) q_20_s_Y) (select (select s_le q_20_s_Y) q_19_s_X)))
      (forall ((q_21_s_Q1 s_quorum) (q_22_s_Q2 s_quorum))
        (exists ((q_23_s_N s_node))
          (and
            (select (select s_member q_23_s_N) q_21_s_Q1)
            (select (select s_member q_23_s_N) q_22_s_Q2)))))
    :trans
    true))
(define-fun property () Bool
  (!
    (forall ((q_135_s_R1 s_round) (q_136_s_V1 s_value) (q_137_s_R2 s_round) (q_138_s_V2 s_value))
      (=>
        (and
          (select (select s_decision q_135_s_R1) q_136_s_V1)
          (select (select s_decision q_137_s_R2) q_138_s_V2))
        (= q_136_s_V1 q_138_s_V2)))
    :invar-property
    0))
