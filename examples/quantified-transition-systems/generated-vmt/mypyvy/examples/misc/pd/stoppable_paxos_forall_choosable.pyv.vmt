            (select (select s_member q_39_s_N) q_37_s_Q1)
            (select (select s_member q_39_s_N) q_38_s_Q2))))
      (forall ((q_40_s_I s_inst) (q_41_s_R s_round) (q_42_s_V s_value) (q_43_s_Q s_quorum))
        (=
          (select (select (select (select s_choosable_next q_40_s_I) q_41_s_R) q_42_s_V) q_43_s_Q)
          (forall ((q_44_s_N s_node))
            (=>
              (select (select s_member q_44_s_N) q_43_s_Q)
              (or
                (not (select (select s_left_5f_round_next q_44_s_N) q_41_s_R))
                (select (select (select (select s_vote_next q_44_s_N) q_40_s_I) q_41_s_R) q_42_s_V)))))))
    :trans
    true))
(define-fun property () Bool
  (!
    (and
      (forall ((q_231_s_N1 s_node) (q_232_s_N2 s_node) (q_233_s_I s_inst) (q_234_s_R1 s_round) (q_235_s_R2 s_round) (q_236_s_V1 s_value) (q_237_s_V2 s_value))
        (=>
          (and
            (select
              (select (select (select s_decision q_231_s_N1) q_233_s_I) q_234_s_R1)
              q_236_s_V1)
            (select
              (select (select (select s_decision q_232_s_N2) q_233_s_I) q_235_s_R2)
              q_237_s_V2))
          (= q_236_s_V1 q_237_s_V2)))
      (forall ((q_238_s_V s_value))
        (forall ((q_239_s_N1 s_node) (q_240_s_N2 s_node) (q_241_s_I1 s_inst) (q_242_s_I2 s_inst) (q_243_s_R1 s_round) (q_244_s_R2 s_round))
          (=>
            (and
              (select (select (select (select s_decision q_239_s_N1) q_241_s_I1) q_243_s_R1) s_stop)
              (not (select (select s_inst_5f_le q_242_s_I2) q_241_s_I1)))
            (not
              (select
                (select (select (select s_decision q_240_s_N2) q_242_s_I2) q_244_s_R2)
                q_238_s_V))))))
