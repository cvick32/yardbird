      (forall ((q_21_s_R s_round) (q_22_s_V s_value) (q_23_s_Q s_quorum))
        (=
          (select (select (select s_choosable_next q_21_s_R) q_22_s_V) q_23_s_Q)
          (forall ((q_24_s_N s_node))
            (=>
              (select (select s_member q_24_s_N) q_23_s_Q)
              (or
                (not (select (select s_left_5f_round_next q_24_s_N) q_21_s_R))
                (select (select (select s_vote_next q_24_s_N) q_21_s_R) q_22_s_V)))))))
    :trans
    true))
(define-fun property () Bool
  (!
    (forall ((q_118_s_R1 s_round) (q_119_s_V1 s_value) (q_120_s_R2 s_round) (q_121_s_V2 s_value))
      (=>
        (and
          (select (select s_decision q_118_s_R1) q_119_s_V1)
          (select (select s_decision q_120_s_R2) q_121_s_V2))
        (= q_119_s_V1 q_121_s_V2)))
    :invar-property
    0))
