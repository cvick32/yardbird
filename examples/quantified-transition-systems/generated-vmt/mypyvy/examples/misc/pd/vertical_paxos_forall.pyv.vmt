        (not (select (select s_decision q_13_s_R) q_14_s_V)))
      (forall ((q_15_s_R s_round) (q_16_s_C s_config))
        (not (select (select s_configure_5f_round_5f_msg q_15_s_R) q_16_s_C)))
      (forall ((q_17_s_R s_round)) (not (select s_complete_5f_msg q_17_s_R)))
      (forall ((q_18_s_R s_round)) (select (select s_le s_master_5f_complete) q_18_s_R))
      (forall ((q_19_s_X s_round)) (select (select s_le q_19_s_X) q_19_s_X))
      (forall ((q_20_s_X s_round) (q_21_s_Y s_round) (q_22_s_Z s_round))
        (=>
          (and (select (select s_le q_20_s_X) q_21_s_Y) (select (select s_le q_21_s_Y) q_22_s_Z))
          (select (select s_le q_20_s_X) q_22_s_Z)))
      (forall ((q_23_s_X s_round) (q_24_s_Y s_round))
        (=>
          (and (select (select s_le q_23_s_X) q_24_s_Y) (select (select s_le q_24_s_Y) q_23_s_X))
          (= q_23_s_X q_24_s_Y)))
      (forall ((q_25_s_X s_round) (q_26_s_Y s_round))
        (or (select (select s_le q_25_s_X) q_26_s_Y) (select (select s_le q_26_s_Y) q_25_s_X)))
      (forall ((q_27_s_C s_config) (q_28_s_Q1 s_quorum) (q_29_s_Q2 s_quorum))
        (=>
          (and
            (select (select s_quorumin q_28_s_Q1) q_27_s_C)
            (select (select s_quorumin q_29_s_Q2) q_27_s_C))
          (exists ((q_30_s_N s_node))
            (and
              (select (select s_member q_30_s_N) q_28_s_Q1)
              (select (select s_member q_30_s_N) q_29_s_Q2)))))
      (forall ((q_31_s_C s_config) (q_32_s_R1 s_round) (q_33_s_R2 s_round))
        (=>
          (and
            (select (select s_complete_5f_of q_31_s_C) q_32_s_R1)
            (select (select s_complete_5f_of q_31_s_C) q_33_s_R2))
          (= q_32_s_R1 q_33_s_R2))))
    :init
    true))
(define-fun trans () Bool
  (!
    (and
      (or action_0 action_1 action_2 action_3 action_4 action_5 action_6 action_7)
      (= s_none_next s_none)
      (= s_le_next s_le)
      (= s_member_next s_member)
      (= s_quorumin_next s_quorumin)
      (= s_complete_5f_of_next s_complete_5f_of)
      (forall ((q_19_s_X s_round)) (select (select s_le q_19_s_X) q_19_s_X))
      (forall ((q_20_s_X s_round) (q_21_s_Y s_round) (q_22_s_Z s_round))
