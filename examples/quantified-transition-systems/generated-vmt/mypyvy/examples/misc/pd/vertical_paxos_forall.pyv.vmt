(define-fun property () Bool
  (!
    (forall ((q_277_s_R1 s_round) (q_278_s_V1 s_value) (q_279_s_R2 s_round) (q_280_s_V2 s_value))
      (=>
        (and
          (select (select s_decision q_277_s_R1) q_278_s_V1)
