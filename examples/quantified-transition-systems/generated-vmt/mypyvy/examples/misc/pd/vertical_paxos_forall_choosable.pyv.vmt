      (forall ((q_17_s_R s_round)) (not (select s_complete_5f_msg q_17_s_R)))
      (forall ((q_18_s_R s_round)) (select (select s_le s_master_5f_complete) q_18_s_R))
      (forall ((q_19_s_X s_round)) (select (select s_le q_19_s_X) q_19_s_X))
      (forall ((q_20_s_X s_round) (q_21_s_Y s_round) (q_22_s_Z s_round))
        (=>
          (and (select (select s_le q_20_s_X) q_21_s_Y) (select (select s_le q_21_s_Y) q_22_s_Z))
          (select (select s_le q_20_s_X) q_22_s_Z)))
      (forall ((q_23_s_X s_round) (q_24_s_Y s_round))
        (=>
          (and (select (select s_le q_23_s_X) q_24_s_Y) (select (select s_le q_24_s_Y) q_23_s_X))
          (= q_23_s_X q_24_s_Y)))
      (forall ((q_25_s_X s_round) (q_26_s_Y s_round))
        (or (select (select s_le q_25_s_X) q_26_s_Y) (select (select s_le q_26_s_Y) q_25_s_X)))
      (forall ((q_27_s_C s_config) (q_28_s_Q1 s_quorum) (q_29_s_Q2 s_quorum))
