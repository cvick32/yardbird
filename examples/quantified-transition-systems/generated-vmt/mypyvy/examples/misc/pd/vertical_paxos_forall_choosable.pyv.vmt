          (exists ((q_30_s_N s_node))
            (and
              (select (select s_member q_30_s_N) q_28_s_Q1)
              (select (select s_member q_30_s_N) q_29_s_Q2)))))
      (forall ((q_31_s_C s_config) (q_32_s_R1 s_round) (q_33_s_R2 s_round))
