(define-fun init () Bool
  (!
    (and
      (forall ((q_1_s_R1 s_round) (q_2_s_R2 s_round))
        (not (select (select s_one_5f_a q_1_s_R1) q_2_s_R2)))
      (forall ((q_3_s_N s_node) (q_4_s_R1 s_round) (q_5_s_R2 s_round))
