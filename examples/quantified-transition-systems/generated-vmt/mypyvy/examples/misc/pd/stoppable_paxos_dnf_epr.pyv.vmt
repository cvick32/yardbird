(define-fun property () Bool
  (!
    (and
      (forall ((q_274_s_N1 s_node) (q_275_s_N2 s_node) (q_276_s_I s_inst) (q_277_s_R1 s_round) (q_278_s_R2 s_round) (q_279_s_V1 s_value) (q_280_s_V2 s_value))
