          (and
            (select
              (select (select (select s_decision q_274_s_N1) q_276_s_I) q_277_s_R1)
              q_279_s_V1)
            (select
              (select (select (select s_decision q_275_s_N2) q_276_s_I) q_278_s_R2)
              q_280_s_V2))
