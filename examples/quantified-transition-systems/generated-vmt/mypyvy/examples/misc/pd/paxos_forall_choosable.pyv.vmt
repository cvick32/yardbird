          (select (select s_le q_14_s_X) q_16_s_Z)))
      (forall ((q_17_s_X s_round) (q_18_s_Y s_round))
        (=>
          (and (select (select s_le q_17_s_X) q_18_s_Y) (select (select s_le q_18_s_Y) q_17_s_X))
          (= q_17_s_X q_18_s_Y)))
      (forall ((q_19_s_X s_round) (q_20_s_Y s_round))
        (or (select (select s_le q_19_s_X) q_20_s_Y) (select (select s_le q_20_s_Y) q_19_s_X)))
      (forall ((q_21_s_Q1 s_quorum) (q_22_s_Q2 s_quorum))
        (exists ((q_23_s_N s_node))
          (and
            (select (select s_member q_23_s_N) q_21_s_Q1)
            (select (select s_member q_23_s_N) q_22_s_Q2))))
      (forall ((q_24_s_R s_round) (q_25_s_V s_value) (q_26_s_Q s_quorum))
        (=
          (select (select (select s_choosable_next q_24_s_R) q_25_s_V) q_26_s_Q)
          (forall ((q_27_s_N s_node))
            (=>
              (select (select s_member q_27_s_N) q_26_s_Q)
              (or
                (not (select (select s_left_5f_round_next q_27_s_N) q_24_s_R))
                (select (select (select s_vote_next q_27_s_N) q_24_s_R) q_25_s_V)))))))
    :trans
    true))
(define-fun property () Bool
  (!
    (forall ((q_121_s_R1 s_round) (q_122_s_V1 s_value) (q_123_s_R2 s_round) (q_124_s_V2 s_value))
      (=>
        (and
          (select (select s_decision q_121_s_R1) q_122_s_V1)
          (select (select s_decision q_123_s_R2) q_124_s_V2))
        (= q_122_s_V1 q_124_s_V2)))
    :invar-property
    0))
