          (and (select (select s_le q_17_s_X) q_18_s_Y) (select (select s_le q_18_s_Y) q_17_s_X))
          (= q_17_s_X q_18_s_Y)))
      (forall ((q_19_s_X s_round) (q_20_s_Y s_round))
        (or (select (select s_le q_19_s_X) q_20_s_Y) (select (select s_le q_20_s_Y) q_19_s_X)))
      (forall ((q_21_s_Q1 s_quorum) (q_22_s_Q2 s_quorum))
        (exists ((q_23_s_N s_node))
          (and
            (select (select s_member q_23_s_N) q_21_s_Q1)
            (select (select s_member q_23_s_N) q_22_s_Q2))))
      (forall ((q_24_s_Q0 s_quorum) (q_25_s_R0 s_round))
        (=
          (select (select s_dr_next q_24_s_Q0) q_25_s_R0)
          (exists ((q_26_s_N0 s_node))
            (and
              (select (select s_member q_26_s_N0) q_24_s_Q0)
              (select (select s_left_5f_round_next q_26_s_N0) q_25_s_R0)
              (select (select s_one_5f_b_next q_26_s_N0) q_25_s_R0))))))
    :trans
    true))
(define-fun property () Bool
  (!
    (forall ((q_120_s_R1 s_round) (q_121_s_V1 s_value) (q_122_s_R2 s_round) (q_123_s_V2 s_value))
      (=>
        (and
          (select (select s_decision q_120_s_R1) q_121_s_V1)
          (select (select s_decision q_122_s_R2) q_123_s_V2))
        (= q_121_s_V1 q_123_s_V2)))
    :invar-property
    0))
