      (forall ((q_20_s_X s_round) (q_21_s_Y s_round))
        (or (select (select s_le q_20_s_X) q_21_s_Y) (select (select s_le q_21_s_Y) q_20_s_X)))
      (forall ((q_22_s_Q1 s_quorum_5f_1) (q_23_s_Q2 s_quorum_5f_2))
        (exists ((q_24_s_N s_node))
          (and
            (select (select s_member_5f_1 q_24_s_N) q_22_s_Q1)
            (select (select s_member_5f_2 q_24_s_N) q_23_s_Q2)))))
    :trans
    true))
(define-fun property () Bool
  (!
    (=>
      (and
        (select (select (select s_decision s_r1) s_v1) s_q1)
        (select (select (select s_decision s_r2) s_v2) s_q2))
      (= s_v1 s_v2))
    :invar-property
    0))
