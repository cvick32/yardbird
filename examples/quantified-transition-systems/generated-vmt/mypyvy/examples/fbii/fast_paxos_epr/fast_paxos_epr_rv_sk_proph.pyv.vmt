        (=>
          (and (select (select s_le q_18_s_X) q_19_s_Y) (select (select s_le q_19_s_Y) q_18_s_X))
          (= q_18_s_X q_19_s_Y)))
      (forall ((q_20_s_X s_round) (q_21_s_Y s_round))
        (or (select (select s_le q_20_s_X) q_21_s_Y) (select (select s_le q_21_s_Y) q_20_s_X)))
