(define-fun property () Bool
  (!
    (and
      (forall ((q_254_s_N1 s_node) (q_255_s_N2 s_node) (q_256_s_I s_inst) (q_257_s_R1 s_round) (q_258_s_R2 s_round) (q_259_s_V1 s_value) (q_260_s_V2 s_value))
        (=>
