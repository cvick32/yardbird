(define-fun init () Bool
  (!
    (and
      (forall ((q_1_s_R s_round)) (not (select s_one_5f_a q_1_s_R)))
      (forall ((q_2_s_N s_node) (q_3_s_R1 s_round) (q_4_s_M s_votemap))
        (not (select (select (select s_one_5f_b_5f_msg q_2_s_N) q_3_s_R1) q_4_s_M)))
      (forall ((q_5_s_N s_node) (q_6_s_R s_round))
        (not (select (select s_left_5f_round q_5_s_N) q_6_s_R)))
      (forall ((q_7_s_N s_node) (q_8_s_R s_round))
        (not (select (select s_joined_5f_round q_7_s_N) q_8_s_R)))
      (forall ((q_9_s_I s_inst) (q_10_s_R s_round) (q_11_s_V s_value))
        (not (select (select (select s_proposal q_9_s_I) q_10_s_R) q_11_s_V)))
      (forall ((q_12_s_R s_round)) (not (select s_active q_12_s_R)))
      (forall ((q_13_s_N s_node) (q_14_s_I s_inst) (q_15_s_R s_round) (q_16_s_V s_value))
        (not (select (select (select (select s_vote q_13_s_N) q_14_s_I) q_15_s_R) q_16_s_V)))
      (forall ((q_17_s_N s_node) (q_18_s_I s_inst) (q_19_s_R s_round) (q_20_s_V s_value))
        (not (select (select (select (select s_decision q_17_s_N) q_18_s_I) q_19_s_R) q_20_s_V)))
      (forall ((q_21_s_X s_round)) (select (select s_le q_21_s_X) q_21_s_X))
      (forall ((q_22_s_X s_round) (q_23_s_Y s_round) (q_24_s_Z s_round))
        (=>
          (and (select (select s_le q_22_s_X) q_23_s_Y) (select (select s_le q_23_s_Y) q_24_s_Z))
          (select (select s_le q_22_s_X) q_24_s_Z)))
      (forall ((q_25_s_X s_round) (q_26_s_Y s_round))
        (=>
          (and (select (select s_le q_25_s_X) q_26_s_Y) (select (select s_le q_26_s_Y) q_25_s_X))
          (= q_25_s_X q_26_s_Y)))
      (forall ((q_27_s_X s_round) (q_28_s_Y s_round))
        (or (select (select s_le q_27_s_X) q_28_s_Y) (select (select s_le q_28_s_Y) q_27_s_X)))
      (forall ((q_29_s_X s_inst)) (select (select s_inst_5f_le q_29_s_X) q_29_s_X))
      (forall ((q_30_s_X s_inst) (q_31_s_Y s_inst) (q_32_s_Z s_inst))
        (=>
          (and
            (select (select s_inst_5f_le q_30_s_X) q_31_s_Y)
            (select (select s_inst_5f_le q_31_s_Y) q_32_s_Z))
          (select (select s_inst_5f_le q_30_s_X) q_32_s_Z)))
      (forall ((q_33_s_X s_inst) (q_34_s_Y s_inst))
        (=>
          (and
            (select (select s_inst_5f_le q_33_s_X) q_34_s_Y)
            (select (select s_inst_5f_le q_34_s_Y) q_33_s_X))
          (= q_33_s_X q_34_s_Y)))
      (forall ((q_35_s_X s_inst) (q_36_s_Y s_inst))
        (or
          (select (select s_inst_5f_le q_35_s_X) q_36_s_Y)
          (select (select s_inst_5f_le q_36_s_Y) q_35_s_X)))
      (forall ((q_37_s_Q1 s_quorum) (q_38_s_Q2 s_quorum))
        (exists ((q_39_s_N s_node))
          (and
            (select (select s_member q_39_s_N) q_37_s_Q1)
            (select (select s_member q_39_s_N) q_38_s_Q2)))))
    :init
    true))
(define-fun trans () Bool
  (!
    (and
      (or action_0 action_1 action_2 action_3 action_4 action_5)
      (= s_none_next s_none)
      (= s_le_next s_le)
      (= s_inst_5f_le_next s_inst_5f_le)
      (= s_stop_next s_stop)
      (= s_member_next s_member)
      (= s_maxr_next s_maxr)
      (= s_maxv_next s_maxv)
      (forall ((q_21_s_X s_round)) (select (select s_le q_21_s_X) q_21_s_X))
      (forall ((q_22_s_X s_round) (q_23_s_Y s_round) (q_24_s_Z s_round))
        (=>
          (and (select (select s_le q_22_s_X) q_23_s_Y) (select (select s_le q_23_s_Y) q_24_s_Z))
          (select (select s_le q_22_s_X) q_24_s_Z)))
      (forall ((q_25_s_X s_round) (q_26_s_Y s_round))
        (=>
          (and (select (select s_le q_25_s_X) q_26_s_Y) (select (select s_le q_26_s_Y) q_25_s_X))
          (= q_25_s_X q_26_s_Y)))
      (forall ((q_27_s_X s_round) (q_28_s_Y s_round))
        (or (select (select s_le q_27_s_X) q_28_s_Y) (select (select s_le q_28_s_Y) q_27_s_X)))
      (forall ((q_29_s_X s_inst)) (select (select s_inst_5f_le q_29_s_X) q_29_s_X))
      (forall ((q_30_s_X s_inst) (q_31_s_Y s_inst) (q_32_s_Z s_inst))
        (=>
          (and
            (select (select s_inst_5f_le q_30_s_X) q_31_s_Y)
            (select (select s_inst_5f_le q_31_s_Y) q_32_s_Z))
          (select (select s_inst_5f_le q_30_s_X) q_32_s_Z)))
      (forall ((q_33_s_X s_inst) (q_34_s_Y s_inst))
        (=>
          (and
            (select (select s_inst_5f_le q_33_s_X) q_34_s_Y)
