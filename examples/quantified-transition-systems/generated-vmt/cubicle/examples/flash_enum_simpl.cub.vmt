              (= (select s_CacheState q_15_s_p) s_CACHE_5f_S)
              (and (= s_Collecting true) (not (= (select s_CacheData q_15_s_p) s_PrevData)))))))
      (=>
        true
        (not
          (and
            (= s_CacheState_5f_home s_CACHE_5f_S)
            (and (= s_Collecting false) (not (= s_CacheData_5f_home s_CurrData))))))
      (forall ((q_16_s_p Proc))
        (=>
          true
          (not
            (and
              (= (select s_CacheState q_16_s_p) s_CACHE_5f_S)
              (and (= s_Collecting false) (not (= (select s_CacheData q_16_s_p) s_CurrData))))))))
    :invar-property
    0))
