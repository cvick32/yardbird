(define-fun property () Bool (! (forall ((|C2:client| client) (|C1:client| client))
  (=> (and (not (= |C1:client| |C2:client|))
           (= (select s.cache |C1:client|) exclusive))
      (= (select s.cache |C2:client|) invalid))) :invar-property 0))
(define-fun property () Bool (! (forall ((|C1:client| client))
  (=> (and s.homeexclusiveGranted
           (not (= s.homeCurrentCommand empty1))
           (= (select s.channel3 |C1:client|) invalidateAck))
      (= |C1:client| owner))) :invar-property 1))