(define-fun trans () Bool (! (and (=> grantexclusiveRule (and (= new_s.homeSharerList (store s.homeSharerList s.homeCurrentclient true))
     (= new_s.homeCurrentCommand empty1)
     new_s.homeexclusiveGranted
     (= new_s.channel2_4
