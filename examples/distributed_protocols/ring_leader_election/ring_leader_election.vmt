(declare-sort node 0)
(declare-sort id 0)
(declare-fun leader () (Array node Bool))
(declare-fun |__fml:n| () node)
(declare-fun __ts0_a () Bool)
(declare-fun pending () (Array id (Array node Bool)))
(declare-fun idn (node) id)
(declare-fun |__fml:m| () id)
(declare-fun |__fml:n1| () node)
(declare-fun new_pending () (Array id (Array node Bool)))
(declare-fun ring.btw (node node node) Bool)
(declare-fun new_leader () (Array node Bool))
(declare-fun |<:id:id| (id id) Bool)
(declare-fun new___fmln () node)
(define-fun .__fmln () node (! |__fml:n| :next new___fmln))
(declare-fun new___ts0_a () Bool)
(define-fun .__ts0_a () Bool (! __ts0_a :next new___ts0_a))
(declare-fun new___fmlm () id)
(define-fun .__fmlm () id (! |__fml:m| :next new___fmlm))
(declare-fun new___fmln1 () node)
(define-fun .__fmln1 () node (! |__fml:n1| :next new___fmln1))
(define-fun .pending () (Array id (Array node Bool)) (! pending :next new_pending))
(define-fun .leader () (Array node Bool) (! leader :next new_leader))
(declare-fun become_leader () Bool)
(define-fun .become_leader () Bool (! become_leader :action 0))
(declare-fun receive () Bool)
(define-fun .receive () Bool (! receive :action 0))
(declare-fun send () Bool)
(define-fun .send () Bool (! send :action 0))
(define-fun init () Bool (! (let ((a!1 (lambda ((|N:node| node)) false)))
  (and (= leader a!1)
       (= pending (lambda ((|V:id| id)) (lambda ((|N:node| node)) false))))) :init true))
(define-fun trans () Bool (! (and (=> become_leader (and (= new_leader (store leader |__fml:n| true))
     (= pending new_pending)
     (select (select pending (idn |__fml:n|)) |__fml:n|)))
(=> receive (let ((a!1 (ite __ts0_a
                (store pending
                       |__fml:m|
                       (store (select pending |__fml:m|) |__fml:n1| true))
                pending))
      (a!2 (= __ts0_a (not (|<:id:id| |__fml:m| (idn |__fml:n|))))))
  (and (= new_pending a!1)
       a!2
       (= leader new_leader)
       (select (select pending |__fml:m|) |__fml:n|)
       (forall ((|Z:node| node)) (not (ring.btw |__fml:n| |Z:node| |__fml:n1|))))))
(=> send (let ((a!1 (store pending
                  (idn |__fml:n|)
                  (store (select pending (idn |__fml:n|)) |__fml:n1| true))))
  (and (= new_pending a!1)
       (= leader new_leader)
       (forall ((|Z:node| node)) (not (ring.btw |__fml:n| |Z:node| |__fml:n1|))))))
(or become_leader receive send)
(or (not become_leader) (not receive))
(or (not become_leader) (not send))
(or (not receive) (not send))) :trans true))
(define-fun property () Bool (! (forall ((|Y:node| node) (|X:node| node))
  (=> (and (select leader |X:node|) (select leader |Y:node|))
      (= |X:node| |Y:node|))) :invar-property 0))
(assert (forall ((|W:node| node) (|X:node| node) (|Y:node| node) (|Z:node| node))
  (or (not (and (ring.btw |W:node| |Y:node| |Z:node|)
                (ring.btw |W:node| |X:node| |Y:node|)))
      (ring.btw |X:node| |Y:node| |Z:node|))))
(assert (forall ((|W:node| node) (|X:node| node) (|Y:node| node) (|Z:node| node))
  (or (not (and (ring.btw |W:node| |X:node| |Z:node|)
                (ring.btw |X:node| |Y:node| |Z:node|)))
      (ring.btw |W:node| |X:node| |Y:node|))))
(assert (forall ((|W:node| node) (|X:node| node) (|Y:node| node) (|Z:node| node))
  (or (not (and (ring.btw |W:node| |X:node| |Z:node|)
                (ring.btw |X:node| |Y:node| |Z:node|)))
      (ring.btw |W:node| |Y:node| |Z:node|))))
(assert (forall ((|W:node| node) (|X:node| node) (|Y:node| node) (|Z:node| node))
  (or (not (and (ring.btw |W:node| |Y:node| |Z:node|)
                (ring.btw |W:node| |X:node| |Y:node|)))
      (ring.btw |W:node| |X:node| |Z:node|))))
(assert (forall ((|W:node| node) (|X:node| node))
  (or (= |W:node| |X:node|) (ring.btw |W:node| |X:node| |W:node|))))
(assert (forall ((|X:node| node) (|Y:node| node))
  (not (ring.btw |X:node| |X:node| |Y:node|))))
(assert (forall ((|X:node| node) (|Y:node| node))
  (not (ring.btw |X:node| |Y:node| |Y:node|))))
(assert (forall ((|X:node| node) (|Y:node| node) (|Z:node| node))
  (or (ring.btw |X:node| |Y:node| |Z:node|)
      (= |Y:node| |Z:node|)
      (ring.btw |X:node| |Z:node| |Y:node|))))
(assert (forall ((|X:node| node) (|Y:node| node) (|Z:node| node))
  (or (ring.btw |X:node| |Y:node| |Z:node|)
      (= |Y:node| |X:node|)
      (ring.btw |Y:node| |X:node| |Z:node|))))
(assert (forall ((|X:id| id) (|Y:id| id) (|Z:id| id))
  (or (not (and (|<:id:id| |X:id| |Y:id|) (|<:id:id| |Y:id| |Z:id|)))
      (|<:id:id| |X:id| |Z:id|))))
(assert (forall ((|X:id| id) (|Y:id| id))
  (not (and (|<:id:id| |X:id| |Y:id|) (|<:id:id| |Y:id| |X:id|)))))
(assert (forall ((|X:id| id) (|Y:id| id))
  (or (|<:id:id| |X:id| |Y:id|) (= |X:id| |Y:id|) (|<:id:id| |Y:id| |X:id|))))
(assert (forall ((|X:node| node) (|Y:node| node))
  (or (not (= (idn |X:node|) (idn |Y:node|))) (= |X:node| |Y:node|))))