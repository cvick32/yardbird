(define-fun init () Bool (! (let ((a!1 (= proposal
              ((as const (Array inst (Array round (Array value Bool))))
                ((as const (Array round (Array value Bool)))
                  ((as const (Array value Bool)) false)))))
      (a!2 ((as const
                (Array node (Array inst (Array round (Array value Bool)))))
             ((as const (Array inst (Array round (Array value Bool))))
               ((as const (Array round (Array value Bool)))
                 ((as const (Array value Bool)) false)))))
      (a!3 (= decision
              ((as const (Array inst (Array round (Array value Bool))))
                ((as const (Array round (Array value Bool)))
                  ((as const (Array value Bool)) false))))))
  (and (= one_a ((as const (Array round Bool)) false))
       a!1
       (= vote a!2)
       a!3
       (= active ((as const (Array round Bool)) false))
       (= left_round
          ((as const (Array round (Array node Bool)))
            ((as const (Array node Bool)) false)))
       (= joined_round
          ((as const (Array round (Array node Bool)))
            ((as const (Array node Bool)) false))))) :init true))
(define-fun trans () Bool (! (and (=> cast_vote (let ((a!1 (store (select (select (select vote |__fml:n|) |__fml:i|) |__fml:r|)
                  |__fml:v|
                  true)))
(let ((a!2 (store (select vote |__fml:n|)
                  |__fml:i|
                  (store (select (select vote |__fml:n|) |__fml:i|)
                         |__fml:r|
                         a!1))))
  (and (= new_vote (store vote |__fml:n| a!2))
       (= decision new_decision)
       (= left_round new_left_round)
       (= joined_round new_joined_round)
       (= proposal new_proposal)
       (= active new_active)
       (= one_a new_one_a)
       (|<:round:round| |0:round| |__fml:r|)
       (not (select (select left_round |__fml:r|) |__fml:n|))
       (select (select (select proposal |__fml:i|) |__fml:r|) |__fml:v|)))))
(=> decide (let ((a!1 (store (select decision |__fml:i|)
                  |__fml:r|
                  (store (select (select decision |__fml:i|) |__fml:r|)
                         |__fml:v|
                         true)))
      (a!2 (forall ((|N:node| node))
             (let ((a!1 (select (select (select (select vote |N:node|)
                                                |__fml:i|)
                                        |__fml:r|)
                                |__fml:v|)))
               (or (not (member |N:node| |__fml:q|)) a!1)))))
  (and (= new_decision (store decision |__fml:i| a!1))
       (= vote new_vote)
       (= left_round new_left_round)
       (= joined_round new_joined_round)
       (= proposal new_proposal)
       (= active new_active)
       (= one_a new_one_a)
       (not (= |__fml:r| |0:round|))
       a!2)))
(=> join_round (let ((a!1 (lambda ((|R:round| round))
             (store (select left_round |R:round|)
                    |__fml:n|
                    (or (select (select left_round |R:round|) |__fml:n|)
                        (|<:round:round| |R:round| |__fml:r|)))))
      (a!2 (= new_joined_round
              (store joined_round
                     |__fml:r|
                     (store (select joined_round |__fml:r|) |__fml:n| true)))))
  (and (= new_left_round a!1)
       a!2
       (= vote new_vote)
       (= decision new_decision)
       (= proposal new_proposal)
       (= active new_active)
       (= one_a new_one_a)
       (select one_a |__fml:r|))))
(=> propose (let ((a!1 (store (select proposal |__fml:i|)
                  |__fml:r|
                  (store (select (select proposal |__fml:i|) |__fml:r|)
                         |__fml:v|
                         true)))
      (a!2 (forall ((|V:value| value))
             (not (select (select (select proposal |__fml:i|) |__fml:r|)
                          |V:value|)))))
  (and (= new_proposal (store proposal |__fml:i| a!1))
       (= vote new_vote)
       (= decision new_decision)
       (= left_round new_left_round)
       (= joined_round new_joined_round)
       (= active new_active)
       (= one_a new_one_a)
       (|<:round:round| |0:round| |__fml:r|)
       (select active |__fml:r|)
       a!2)))
(=> receive_join_acks (let ((a!1 (= new_proposal
              (lambda ((|I:inst| inst))
                (let ((a!1 (lambda ((|V:value| value))
                             (or (select (select (select proposal |I:inst|)
                                                 |__fml:r|)
                                         |V:value|)
                                 (and (|<:round:round| |0:round|
                                                       (select |loc:maxr|
                                                               |I:inst|))
                                      (= |V:value| (select |loc:maxv| |I:inst|)))))))
                  (store (select proposal |I:inst|) |__fml:r| a!1)))))
      (a!2 (forall ((|N:node| node))
             (or (not (member |N:node| |__fml:q|))
                 (select (select joined_round |__fml:r|) |N:node|)))))
  (and (= new_active (store active |__fml:r| true))
       a!1
       (= vote new_vote)
       (= decision new_decision)
       (= left_round new_left_round)
       (= joined_round new_joined_round)
       (= one_a new_one_a)
       (not (= |__fml:r| |0:round|))
       (not (select active |__fml:r|))
       a!2
       (forall ((|I:inst| inst))
         (let ((a!1 (forall ((|R:round| round)
                             (|V:value| value)
                             (|N:node| node))
                      (let ((a!1 (select (select (select (select vote |N:node|)
                                                         |I:inst|)
                                                 |R:round|)
                                         |V:value|)))
                        (not (and (member |N:node| |__fml:q|)
                                  (|<:round:round| |R:round| |__fml:r|)
                                  a!1)))))
               (a!3 (exists ((|N:node| node))
                      (let ((a!1 (select (select (select (select vote |N:node|)
                                                         |I:inst|)
                                                 (select |loc:maxr| |I:inst|))
                                         (select |loc:maxv| |I:inst|))))
                        (and (member |N:node| |__fml:q|)
                             (|<:round:round| (select |loc:maxr| |I:inst|)
                                              |__fml:r|)
                             a!1))))
               (a!4 (forall ((|R:round| round)
                             (|V:value| value)
                             (|N:node| node))
                      (let ((a!1 (select (select (select (select vote |N:node|)
                                                         |I:inst|)
                                                 |R:round|)
                                         |V:value|)))
                        (or (not (and (member |N:node| |__fml:q|)
                                      (|<:round:round| |R:round| |__fml:r|)
                                      a!1))
                            (not (|<:round:round| (select |loc:maxr| |I:inst|)
                                                  |R:round|)))))))
         (let ((a!2 (and (not (|<:round:round| |0:round|
                                               (select |loc:maxr| |I:inst|)))
                         a!1)))
           (or a!2 (and a!3 a!4))))))))
(=> send_1a (and (= new_one_a (store one_a |__fml:r| true))
     (= vote new_vote)
     (= decision new_decision)
     (= left_round new_left_round)
     (= joined_round new_joined_round)
     (= proposal new_proposal)
     (= active new_active)
     (not (= |__fml:r| |0:round|))))
(=> send_one_b (let ((a!1 (forall ((|R:round| round) (|V:value| value) (|I:inst| inst))
             (let ((a!1 (select (select (select (select vote |__fml:n|)
                                                |I:inst|)
                                        |R:round|)
                                |V:value|)))
               (or (not (and a!1 (|<:round:round| |R:round| |__fml:r|)))
                   (not (|<:round:round| (maxr |__fml:m| |I:inst|) |R:round|))))))
      (a!2 (forall ((|I:inst| inst))
             (let ((a!1 (select (select (select (select vote |__fml:n|)
                                                |I:inst|)
                                        (maxr |__fml:m| |I:inst|))
                                (maxv |__fml:m| |I:inst|))))
               (or (not (|<:round:round| |0:round| (maxr |__fml:m| |I:inst|)))
                   (and a!1
                        (|<:round:round| (maxr |__fml:m| |I:inst|) |__fml:r|)))))))
  (and (= vote new_vote)
       (= decision new_decision)
       (= left_round new_left_round)
       (= joined_round new_joined_round)
       (= proposal new_proposal)
       (= active new_active)
       (= one_a new_one_a)
       (|<:round:round| |0:round| |__fml:r|)
       (not (select (select left_round |__fml:r|) |__fml:n|))
       (select (select joined_round |__fml:r|) |__fml:n|)
       a!1
       a!2)))
(or cast_vote decide join_round propose receive_join_acks send_1a send_one_b)
(or (not cast_vote) (not decide))
(or (not cast_vote) (not join_round))
(or (not cast_vote) (not propose))
(or (not cast_vote) (not receive_join_acks))
(or (not cast_vote) (not send_1a))
(or (not cast_vote) (not send_one_b))
(or (not decide) (not join_round))
(or (not decide) (not propose))
(or (not decide) (not receive_join_acks))
(or (not decide) (not send_1a))
(or (not decide) (not send_one_b))
(or (not join_round) (not propose))
(or (not join_round) (not receive_join_acks))
(or (not join_round) (not send_1a))
(or (not join_round) (not send_one_b))
(or (not propose) (not receive_join_acks))
(or (not propose) (not send_1a))
(or (not propose) (not send_one_b))
(or (not receive_join_acks) (not send_1a))
(or (not receive_join_acks) (not send_one_b))
(or (not send_1a) (not send_one_b))) :trans true))
(define-fun property () Bool (! (forall ((|N:node| node) (|R1:round| round) (|R2:round| round))
  (=> (and (|<:round:round| |R1:round| |R2:round|)
           (select (select left_round |R2:round|) |N:node|))
      (select (select left_round |R1:round|) |N:node|))) :invar-property 0))
(define-fun property () Bool (! (forall ((|N:node| node) (|R:round| round) (|R1:round| round))
  (=> (and (select (select joined_round |R:round|) |N:node|)
           (|<:round:round| |R1:round| |R:round|))
      (select (select left_round |R1:round|) |N:node|))) :invar-property 1))
(define-fun property () Bool (! (forall ((|I:inst| inst)
         (|R1:round| round)
         (|R2:round| round)
         (|V1:value| value)
         (|V2:value| value))
  (let ((a!1 (and (select (select (select decision |I:inst|) |R1:round|)
                          |V1:value|)
                  (select (select (select decision |I:inst|) |R2:round|)
                          |V2:value|))))
    (=> a!1 (= |V1:value| |V2:value|)))) :invar-property 2))
(assert (forall ((|T:round| round) (|U:round| round) (|V:round| round))
  (or (not (and (|<:round:round| |T:round| |U:round|)
                (|<:round:round| |U:round| |V:round|)))
      (|<:round:round| |T:round| |V:round|))))
(assert (forall ((|T:round| round) (|U:round| round))
  (not (and (|<:round:round| |T:round| |U:round|)
            (|<:round:round| |U:round| |T:round|)))))
(assert (forall ((|T:round| round) (|U:round| round))
  (or (|<:round:round| |T:round| |U:round|)
      (= |T:round| |U:round|)
      (|<:round:round| |U:round| |T:round|))))
(assert (forall ((|Q1:quorum| quorum) (|Q2:quorum| quorum))
  (exists ((|N:node| node))
    (and (member |N:node| |Q1:quorum|) (member |N:node| |Q2:quorum|)))))
(assert (forall ((|Q:quorum| quorum))
  (exists ((|N:node| node)) (not (member |N:node| |Q:quorum|)))))
(assert (forall ((|Q1:quorum| quorum) (|Q2:quorum| quorum))
  (let ((a!1 (exists ((|N:node| node))
               (and (member |N:node| |Q1:quorum|)
                    (not (member |N:node| |Q2:quorum|))))))
    (or (= |Q1:quorum| |Q2:quorum|) a!1))))
(assert (forall ((|R:round| round)) (not (|<:round:round| |R:round| |0:round|))))