(declare-sort request 0)
(declare-sort response 0)
(declare-sort node 0)
(declare-fun |__fml:r| () request)
(declare-fun new_request_sent () (Array node (Array request Bool)))
(declare-fun new_response_sent () (Array node (Array response Bool)))
(declare-fun |match| (request response) Bool)
(declare-fun response_sent () (Array node (Array response Bool)))
(declare-fun request_sent () (Array node (Array request Bool)))
(declare-fun response_received () (Array node (Array response Bool)))
(declare-fun |__fml:p| () response)
(declare-fun |__fml:n| () node)
(declare-fun new_response_received () (Array node (Array response Bool)))
(declare-fun new___fmlr () request)
(define-fun .__fmlr () request (! |__fml:r| :next new___fmlr))
(define-fun .request_sent () (Array node (Array request Bool)) (! request_sent :next new_request_sent))
(define-fun .response_sent () (Array node (Array response Bool)) (! response_sent :next new_response_sent))
(declare-fun new___fmlp () response)
(define-fun .__fmlp () response (! |__fml:p| :next new___fmlp))
(declare-fun new___fmln () node)
(define-fun .__fmln () node (! |__fml:n| :next new___fmln))
(define-fun .response_received () (Array node (Array response Bool)) (! response_received :next new_response_received))
(declare-fun new_request () Bool)
(define-fun .new_request () Bool (! new_request :action 0))
(declare-fun receive_response () Bool)
(define-fun .receive_response () Bool (! receive_response :action 0))
(declare-fun respond () Bool)
(define-fun .respond () Bool (! respond :action 0))
(define-fun init () Bool (! (let ((a!1 (lambda ((|N:node| node)) (lambda ((|P:response| response)) false))))
  (and (= request_sent
          (lambda ((|N:node| node)) (lambda ((|R:request| request)) false)))
       (= response_sent a!1)
       (= response_received a!1))) :init true))
(define-fun trans () Bool (! (and (=> new_request (let ((a!1 (= new_request_sent
              (store request_sent
                     |__fml:n|
                     (store (select request_sent |__fml:n|) |__fml:r| true)))))
  (and a!1
       (= response_received new_response_received)
       (= response_sent new_response_sent))))
(=> receive_response (let ((a!1 (= new_response_received
              (store response_received
                     |__fml:n|
                     (store (select response_received |__fml:n|) |__fml:p| true)))))
  (and a!1
       (= request_sent new_request_sent)
       (= response_sent new_response_sent)
       (select (select response_sent |__fml:n|) |__fml:p|))))
(=> respond (let ((a!1 (= new_response_sent
              (store response_sent
                     |__fml:n|
                     (store (select response_sent |__fml:n|) |__fml:p| true)))))
  (and a!1
       (= request_sent new_request_sent)
       (= response_received new_response_received)
       (select (select request_sent |__fml:n|) |__fml:r|)
       (|match| |__fml:r| |__fml:p|))))
(or new_request receive_response respond)
(or (not new_request) (not receive_response))
(or (not new_request) (not respond))
(or (not receive_response) (not respond))) :trans true))
(define-fun property () Bool (! (forall ((|P:response| response) (|N:node| node))
  (let ((a!1 (exists ((|R:request| request))
               (and (select (select request_sent |N:node|) |R:request|)
                    (|match| |R:request| |P:response|)))))
    (=> (select (select response_received |N:node|) |P:response|) a!1))) :invar-property 0))
