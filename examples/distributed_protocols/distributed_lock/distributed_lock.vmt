(declare-sort epoch 0)
(declare-sort node 0)
(declare-fun zero () epoch)
(declare-fun ep () (Array node epoch))
(declare-fun |__fml:e| () epoch)
(declare-fun e1 () epoch)
(declare-fun __m_ep () (Array node epoch))
(declare-fun new_transfer () (Array epoch (Array node Bool)))
(declare-fun transfer () (Array epoch (Array node Bool)))
(declare-fun |<:epoch:epoch| (epoch epoch) Bool)
(declare-fun new_locked () (Array epoch (Array node Bool)))
(declare-fun |__fml:n1| () node)
(declare-fun held () (Array node Bool))
(declare-fun |__fml:n2| () node)
(declare-fun |__fml:n| () node)
(declare-fun first () node)
(declare-fun locked () (Array epoch (Array node Bool)))
(declare-fun new_ep () (Array node epoch))
(declare-fun new_held () (Array node Bool))
(declare-fun new___fmle () epoch)
(define-fun .__fmle () epoch (! |__fml:e| :next new___fmle))
(declare-fun new___m_ep () (Array node epoch))
(define-fun .__m_ep () (Array node epoch) (! __m_ep :next new___m_ep))
(define-fun .transfer () (Array epoch (Array node Bool)) (! transfer :next new_transfer))
(define-fun .locked () (Array epoch (Array node Bool)) (! locked :next new_locked))
(declare-fun new___fmln1 () node)
(define-fun .__fmln1 () node (! |__fml:n1| :next new___fmln1))
(declare-fun new___fmln2 () node)
(define-fun .__fmln2 () node (! |__fml:n2| :next new___fmln2))
(declare-fun new___fmln () node)
(define-fun .__fmln () node (! |__fml:n| :next new___fmln))
(declare-fun new_first () node)
(define-fun .first () node (! first :next new_first))
(define-fun .ep () (Array node epoch) (! ep :next new_ep))
(define-fun .held () (Array node Bool) (! held :next new_held))
(declare-fun accept () Bool)
(define-fun .accept () Bool (! accept :action 0))
(declare-fun grant () Bool)
(define-fun .grant () Bool (! grant :action 0))
(define-fun init () Bool (! (let ((a!1 (lambda ((|E:epoch| epoch)) (lambda ((|N:node| node)) false))))
  (and (= held (lambda ((|X:node| node)) (= |X:node| first)))
       (= __m_ep (lambda ((|N:node| node)) zero))
       (= ep (store __m_ep first e1))
       (= transfer a!1)
       (= locked a!1))) :init true))
(define-fun trans () Bool (! (and (=> accept (let ((a!1 (= new_locked
              (store locked
                     |__fml:e|
                     (store (select locked |__fml:e|) |__fml:n| true)))))
  (and (= new_held (store held |__fml:n| true))
       (= new_ep (store ep |__fml:n| |__fml:e|))
       a!1
       (= transfer new_transfer)
       (select (select transfer |__fml:e|) |__fml:n|)
       (|<:epoch:epoch| (select ep |__fml:n|) |__fml:e|))))
(=> grant (let ((a!1 (= new_transfer
              (store transfer
                     |__fml:e|
                     (store (select transfer |__fml:e|) |__fml:n2| true)))))
  (and a!1
       (= new_held (store held |__fml:n1| false))
       (= ep new_ep)
       (= locked new_locked)
       (select held |__fml:n1|)
       (|<:epoch:epoch| (select ep |__fml:n1|) |__fml:e|))))
(or accept grant)
(or (not accept) (not grant))
(= first new_first)) :trans true))
(define-fun property () Bool (! (forall ((|E:epoch| epoch) (|N1:node| node) (|N2:node| node))
  (=> (and (select (select locked |E:epoch|) |N1:node|)
           (select (select locked |E:epoch|) |N2:node|))
      (= |N1:node| |N2:node|))) :invar-property 0))
(assert (forall ((|T:epoch| epoch) (|U:epoch| epoch) (|V:epoch| epoch))
  (or (not (and (|<:epoch:epoch| |T:epoch| |U:epoch|)
                (|<:epoch:epoch| |U:epoch| |V:epoch|)))
      (|<:epoch:epoch| |T:epoch| |V:epoch|))))
(assert (forall ((|T:epoch| epoch) (|U:epoch| epoch))
  (not (and (|<:epoch:epoch| |T:epoch| |U:epoch|)
            (|<:epoch:epoch| |U:epoch| |T:epoch|)))))
(assert (forall ((|T:epoch| epoch) (|U:epoch| epoch))
  (or (|<:epoch:epoch| |T:epoch| |U:epoch|)
      (= |T:epoch| |U:epoch|)
      (|<:epoch:epoch| |U:epoch| |T:epoch|))))
(assert (forall ((|X:epoch| epoch)) (not (|<:epoch:epoch| |X:epoch| zero))))
(assert (not (= e1 zero)))