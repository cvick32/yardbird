(define-fun init () Bool (! (let ((a!1 (lambda ((|N:node| node)) (lambda ((|P:response| response)) false))))
  (and (= request_sent
          (lambda ((|N:node| node)) (lambda ((|R:request| request)) false)))
       (= response_sent a!1)
       (= response_received a!1)
