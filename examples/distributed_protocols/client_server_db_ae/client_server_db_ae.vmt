       (= response_received new_response_received)
       (= response_sent new_response_sent)
       (select (select request_sent |__fml:n|) |__fml:r|)
       a!3)))
(or db_process_request new_request receive_response server_process_db_response server_process_request)
(or (not db_process_request) (not new_request))
(or (not db_process_request) (not receive_response))
(or (not db_process_request) (not server_process_db_response))
(or (not db_process_request) (not server_process_request))
(or (not new_request) (not receive_response))
(or (not new_request) (not server_process_db_response))
(or (not new_request) (not server_process_request))
(or (not receive_response) (not server_process_db_response))
(or (not receive_response) (not server_process_request))
(or (not server_process_db_response) (not server_process_request))) :trans true))
(define-fun property () Bool (! (forall ((|N:node| node) (|P:response| response))
  (let ((a!1 (exists ((|R:request| request))
               (and (select (select request_sent |N:node|) |R:request|)
                    (|match| |R:request| |P:response|)))))
    (=> (select (select response_received |N:node|) |P:response|) a!1))) :invar-property 0))
