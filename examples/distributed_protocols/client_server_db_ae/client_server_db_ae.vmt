            (lambda ((|P:response| response)) false)))
       (= t
          (lambda ((|I:db_request_id| db_request_id))
            (lambda ((|N:node| node)) false))))) :init true))
(define-fun trans () Bool (! (and (=> db_process_request (let ((a!1 (= new_db_response_sent
              (store db_response_sent
                     |__fml:i|
