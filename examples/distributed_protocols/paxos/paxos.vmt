(declare-sort round 0)
(declare-sort value 0)
(declare-sort node 0)
(declare-sort quorum 0)
(declare-fun new_left_rnd () (Array node (Array round Bool)))
(declare-fun |<:round:round| (round round) Bool)
(declare-fun proposal () (Array round (Array value Bool)))
(declare-fun new_decision () (Array node (Array round (Array value Bool))))
(declare-fun |__fml:r| () round)
(declare-fun |__fml:v| () value)
(declare-fun member (node quorum) Bool)
(declare-fun left_rnd () (Array node (Array round Bool)))
(declare-fun |0:round| () round)
(declare-fun new_vote () (Array node (Array round (Array value Bool))))
(declare-fun |__fml:q| () quorum)
(declare-fun one_a () (Array round Bool))
(declare-fun one_b () (Array node (Array round Bool)))
(declare-fun |__fml:n| () node)
(declare-fun new_proposal () (Array round (Array value Bool)))
(declare-fun decision () (Array node (Array round (Array value Bool))))
(declare-fun vote () (Array node (Array round (Array value Bool))))
(declare-fun new_one_a () (Array round Bool))
(declare-fun |__fml:maxr| () round)
(declare-fun new_one_b () (Array node (Array round Bool)))
(define-fun .left_rnd () (Array node (Array round Bool)) (! left_rnd :next new_left_rnd))
(define-fun .decision () (Array node (Array round (Array value Bool))) (! decision :next new_decision))
(declare-fun new___fmlr () round)
(define-fun .__fmlr () round (! |__fml:r| :next new___fmlr))
(declare-fun new___fmlv () value)
(define-fun .__fmlv () value (! |__fml:v| :next new___fmlv))
(define-fun .vote () (Array node (Array round (Array value Bool))) (! vote :next new_vote))
(declare-fun new___fmlq () quorum)
(define-fun .__fmlq () quorum (! |__fml:q| :next new___fmlq))
(declare-fun new___fmln () node)
(define-fun .__fmln () node (! |__fml:n| :next new___fmln))
(define-fun .proposal () (Array round (Array value Bool)) (! proposal :next new_proposal))
(define-fun .one_a () (Array round Bool) (! one_a :next new_one_a))
(declare-fun new___fmlmaxr () round)
(define-fun .__fmlmaxr () round (! |__fml:maxr| :next new___fmlmaxr))
(define-fun .one_b () (Array node (Array round Bool)) (! one_b :next new_one_b))
(declare-fun cast_vote () Bool)
(define-fun .cast_vote () Bool (! cast_vote :action 0))
(declare-fun decide () Bool)
(define-fun .decide () Bool (! decide :action 0))
(declare-fun join_round () Bool)
(define-fun .join_round () Bool (! join_round :action 0))
(declare-fun propose () Bool)
(define-fun .propose () Bool (! propose :action 0))
(declare-fun send_1a () Bool)
(define-fun .send_1a () Bool (! send_1a :action 0))
(define-fun init () Bool (! (let ((a!1 (lambda ((|R:round| round)) false))
      (a!2 (lambda ((|N:node| node)) (lambda ((|R:round| round)) false)))
      (a!3 (lambda ((|R:round| round)) (lambda ((|V:value| value)) false)))
      (a!4 (lambda ((|N:node| node))
             (lambda ((|R:round| round)) (lambda ((|V:value| value)) false)))))
  (and (= one_a a!1)
       (= one_b a!2)
       (= left_rnd a!2)
       (= proposal a!3)
       (= vote a!4)
       (= decision a!4))) :init true))
(define-fun trans () Bool (! (and (=> cast_vote (let ((a!1 (store (select vote |__fml:n|)
                  |__fml:r|
                  (store (select (select vote |__fml:n|) |__fml:r|)
                         |__fml:v|
                         true))))
  (and (= new_vote (store vote |__fml:n| a!1))
       (= decision new_decision)
       (= left_rnd new_left_rnd)
       (= one_b new_one_b)
       (= proposal new_proposal)
       (= one_a new_one_a)
       (not (= |__fml:r| |0:round|))
       (not (select (select left_rnd |__fml:n|) |__fml:r|))
       (select (select proposal |__fml:r|) |__fml:v|))))
(=> decide (let ((a!1 (store (select decision |__fml:n|)
                  |__fml:r|
                  (store (select (select decision |__fml:n|) |__fml:r|)
                         |__fml:v|
                         true)))
      (a!2 (forall ((|N:node| node))
             (or (not (member |N:node| |__fml:q|))
                 (select (select (select vote |N:node|) |__fml:r|) |__fml:v|)))))
  (and (= new_decision (store decision |__fml:n| a!1))
       (= vote new_vote)
       (= left_rnd new_left_rnd)
       (= one_b new_one_b)
       (= proposal new_proposal)
       (= one_a new_one_a)
       (not (= |__fml:r| |0:round|))
       a!2)))
(=> join_round (let ((a!1 (= new_one_b
              (store one_b
                     |__fml:n|
                     (store (select one_b |__fml:n|) |__fml:r| true))))
      (a!2 (lambda ((|R:round| round))
             (or (select (select left_rnd |__fml:n|) |R:round|)
                 (|<:round:round| |R:round| |__fml:r|))))
      (a!3 (forall ((|MAXR:round| round) (|V:value| value))
             (let ((a!1 (and (|<:round:round| |MAXR:round| |__fml:r|)
                             (select (select (select vote |__fml:n|)
                                             |MAXR:round|)
                                     |V:value|))))
               (or (not a!1) (not (|<:round:round| |__fml:maxr| |MAXR:round|)))))))
(let ((a!4 (and (not (= |__fml:maxr| |0:round|))
                (|<:round:round| |__fml:maxr| |__fml:r|)
                (select (select (select vote |__fml:n|) |__fml:maxr|) |__fml:v|)
                a!3)))
(let ((a!5 (or (and (= |__fml:maxr| |0:round|)
                    (forall ((|MAXR:round| round) (|V:value| value))
                      (let ((a!1 (and (|<:round:round| |MAXR:round| |__fml:r|)
                                      (select (select (select vote |__fml:n|)
                                                      |MAXR:round|)
                                              |V:value|))))
                        (not a!1))))
               a!4)))
  (and a!1
       (= new_left_rnd (store left_rnd |__fml:n| a!2))
       (= vote new_vote)
       (= decision new_decision)
       (= proposal new_proposal)
       (= one_a new_one_a)
       (not (= |__fml:r| |0:round|))
       (select one_a |__fml:r|)
       (not (select (select left_rnd |__fml:n|) |__fml:r|))
       a!5)))))
(=> propose (let ((a!1 (= new_proposal
              (store proposal
                     |__fml:r|
                     (store (select proposal |__fml:r|) |__fml:v| true))))
      (a!2 (forall ((|V:value| value))
             (not (select (select proposal |__fml:r|) |V:value|))))
      (a!3 (forall ((|N:node| node))
             (or (not (member |N:node| |__fml:q|))
                 (select (select one_b |N:node|) |__fml:r|))))
      (a!4 (exists ((|N:node| node))
             (and (member |N:node| |__fml:q|)
                  (|<:round:round| |__fml:maxr| |__fml:r|)
                  (select (select (select vote |N:node|) |__fml:maxr|)
                          |__fml:v|))))
      (a!5 (forall ((|N:node| node) (|MAXR:round| round) (|V:value| value))
             (let ((a!1 (and (member |N:node| |__fml:q|)
                             (|<:round:round| |MAXR:round| |__fml:r|)
                             (select (select (select vote |N:node|)
                                             |MAXR:round|)
                                     |V:value|))))
               (or (not a!1) (not (|<:round:round| |__fml:maxr| |MAXR:round|)))))))
(let ((a!6 (or (and (= |__fml:maxr| |0:round|)
                    (forall ((|N:node| node)
                             (|MAXR:round| round)
                             (|V:value| value))
                      (let ((a!1 (and (member |N:node| |__fml:q|)
                                      (|<:round:round| |MAXR:round| |__fml:r|)
                                      (select (select (select vote |N:node|)
                                                      |MAXR:round|)
                                              |V:value|))))
                        (not a!1))))
               (and (not (= |__fml:maxr| |0:round|)) a!4 a!5))))
  (and a!1
       (= vote new_vote)
       (= decision new_decision)
       (= left_rnd new_left_rnd)
       (= one_b new_one_b)
       (= one_a new_one_a)
       (not (= |__fml:r| |0:round|))
       a!2
       a!3
       a!6))))
(=> send_1a (and (= new_one_a (store one_a |__fml:r| true))
     (= vote new_vote)
     (= decision new_decision)
     (= left_rnd new_left_rnd)
     (= one_b new_one_b)
     (= proposal new_proposal)
     (not (= |__fml:r| |0:round|))))
(or cast_vote decide join_round propose send_1a)
(or (not cast_vote) (not decide))
(or (not cast_vote) (not join_round))
(or (not cast_vote) (not propose))
(or (not cast_vote) (not send_1a))
(or (not decide) (not join_round))
(or (not decide) (not propose))
(or (not decide) (not send_1a))
(or (not join_round) (not propose))
(or (not join_round) (not send_1a))
(or (not propose) (not send_1a))) :trans true))
(define-fun property () Bool (! (forall ((|N1:node| node)
         (|N2:node| node)
         (|R1:round| round)
         (|R2:round| round)
         (|V1:value| value)
         (|V2:value| value))
  (let ((a!1 (and (select (select (select decision |N1:node|) |R1:round|)
                          |V1:value|)
                  (select (select (select decision |N2:node|) |R2:round|)
                          |V2:value|))))
    (=> a!1 (= |V1:value| |V2:value|)))) :invar-property 0))
(define-fun property () Bool (! (forall ((|N:node| node) (|R1:round| round) (|R2:round| round))
  (=> (and (|<:round:round| |R1:round| |R2:round|)
           (select (select left_rnd |N:node|) |R2:round|))
      (select (select left_rnd |N:node|) |R1:round|))) :invar-property 1))
(define-fun property () Bool (! (forall ((|R:round| round) (|V1:value| value) (|V2:value| value))
  (=> (and (select (select proposal |R:round|) |V1:value|)
           (select (select proposal |R:round|) |V2:value|))
      (= |V1:value| |V2:value|))) :invar-property 2))
(define-fun property () Bool (! (forall ((|N:node| node) (|R:round| round) (|V:value| value))
  (=> (select (select (select vote |N:node|) |R:round|) |V:value|)
      (select (select proposal |R:round|) |V:value|))) :invar-property 3))
(define-fun property () Bool (! (forall ((|V:value| value) (|R:round| round))
  (let ((a!1 (exists ((|N:node| node))
               (select (select (select decision |N:node|) |R:round|) |V:value|)))
        (a!2 (exists ((|Q:quorum| quorum))
               (forall ((|N:node| node))
                 (=> (member |N:node| |Q:quorum|)
                     (select (select (select vote |N:node|) |R:round|)
                             |V:value|))))))
    (=> a!1 a!2))) :invar-property 4))
(define-fun property () Bool (! (forall ((|N:node| node) (|V:value| value))
  (not (select (select (select vote |N:node|) |0:round|) |V:value|))) :invar-property 5))
(define-fun property () Bool (! (forall ((|N:node| node) (|R1:round| round) (|R2:round| round))
  (=> (and (select (select one_b |N:node|) |R2:round|)
           (|<:round:round| |R1:round| |R2:round|))
      (select (select left_rnd |N:node|) |R1:round|))) :invar-property 6))
(assert (forall ((|T:round| round) (|U:round| round) (|V:round| round))
  (or (not (and (|<:round:round| |T:round| |U:round|)
                (|<:round:round| |U:round| |V:round|)))
      (|<:round:round| |T:round| |V:round|))))
(assert (forall ((|T:round| round) (|U:round| round))
  (not (and (|<:round:round| |T:round| |U:round|)
            (|<:round:round| |U:round| |T:round|)))))
(assert (forall ((|T:round| round) (|U:round| round))
  (or (|<:round:round| |T:round| |U:round|)
      (= |T:round| |U:round|)
      (|<:round:round| |U:round| |T:round|))))
(assert (forall ((|Q1:quorum| quorum) (|Q2:quorum| quorum))
  (exists ((|N:node| node))
    (and (member |N:node| |Q1:quorum|) (member |N:node| |Q2:quorum|)))))
(assert (forall ((|Q:quorum| quorum))
  (exists ((|N:node| node)) (not (member |N:node| |Q:quorum|)))))
(assert (forall ((|Q1:quorum| quorum) (|Q2:quorum| quorum))
  (let ((a!1 (exists ((|N:node| node))
               (and (member |N:node| |Q1:quorum|)
                    (not (member |N:node| |Q2:quorum|))))))
    (or (= |Q1:quorum| |Q2:quorum|) a!1))))
(assert (forall ((|R:round| round)) (not (|<:round:round| |R:round| |0:round|))))