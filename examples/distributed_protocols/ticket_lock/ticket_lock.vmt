(declare-sort thread 0)
(declare-sort ticket 0)
(declare-fun |fml:t| () thread)
(declare-fun new_service () ticket)
(declare-fun |__fml:y| () ticket)
(declare-fun new_pc2 () (Array thread Bool))
(declare-fun pc2 () (Array thread Bool))
(declare-fun pc3 () (Array thread Bool))
(declare-fun new_pc3 () (Array thread Bool))
(declare-fun new_next_ticket () ticket)
(declare-fun |0:ticket| () ticket)
(declare-fun |__new_fml:x| () ticket)
(declare-fun service () ticket)
(declare-fun new_m () (Array thread ticket))
(declare-fun |<:ticket:ticket| (ticket ticket) Bool)
(declare-fun next_ticket () ticket)
(declare-fun m () (Array thread ticket))
(declare-fun new_pc1 () (Array thread Bool))
(declare-fun pc1 () (Array thread Bool))
(declare-fun new_fmlt () thread)
(define-fun .fmlt () thread (! |fml:t| :next new_fmlt))
(define-fun .service () ticket (! service :next new_service))
(declare-fun new___fmly () ticket)
(define-fun .__fmly () ticket (! |__fml:y| :next new___fmly))
(define-fun .pc2 () (Array thread Bool) (! pc2 :next new_pc2))
(define-fun .pc3 () (Array thread Bool) (! pc3 :next new_pc3))
(define-fun .next_ticket () ticket (! next_ticket :next new_next_ticket))
(declare-fun new___new_fmlx () ticket)
(define-fun .__new_fmlx () ticket (! |__new_fml:x| :next new___new_fmlx))
(define-fun .m () (Array thread ticket) (! m :next new_m))
(define-fun .pc1 () (Array thread Bool) (! pc1 :next new_pc1))
(declare-fun step12 () Bool)
(define-fun .step12 () Bool (! step12 :action 0))
(declare-fun step23 () Bool)
(define-fun .step23 () Bool (! step23 :action 0))
(declare-fun step31 () Bool)
(define-fun .step31 () Bool (! step31 :action 0))
(define-fun init () Bool (! (and (= pc1 ((as const (Array thread Bool)) true))
     (= pc2 ((as const (Array thread Bool)) false))
     (= pc3 ((as const (Array thread Bool)) false))
     (= service |0:ticket|)
     (= next_ticket |0:ticket|)
     (= m ((as const (Array thread ticket)) |0:ticket|))) :init true))
(define-fun trans () Bool (! (and (=> step12 (let ((a!1 (forall ((|Y:ticket| ticket))
             (or (not (|<:ticket:ticket| |__new_fml:x| |Y:ticket|))
                 (= |__fml:y| |Y:ticket|)
                 (|<:ticket:ticket| |__fml:y| |Y:ticket|)))))
  (and (= new_m (store m |fml:t| next_ticket))
       (= new_pc1 (store pc1 |fml:t| false))
       (= new_pc2 (store pc2 |fml:t| true))
       (= |__new_fml:x| next_ticket)
       (= new_next_ticket |__fml:y|)
       (= pc3 new_pc3)
       (= service new_service)
       (select pc1 |fml:t|)
       (|<:ticket:ticket| |__new_fml:x| |__fml:y|)
       a!1)))
(=> step23 (and (= new_pc2 (store pc2 |fml:t| false))
     (= new_pc3 (store pc3 |fml:t| true))
     (= pc1 new_pc1)
     (= next_ticket new_next_ticket)
     (= m new_m)
     (= service new_service)
     (select pc2 |fml:t|)
     (= (select m |fml:t|) service)))
(=> step31 (let ((a!1 (forall ((|Y:ticket| ticket))
             (or (not (|<:ticket:ticket| |__new_fml:x| |Y:ticket|))
                 (= |__fml:y| |Y:ticket|)
                 (|<:ticket:ticket| |__fml:y| |Y:ticket|)))))
  (and (= |__new_fml:x| service)
       (= new_service |__fml:y|)
       (= new_pc3 (store pc3 |fml:t| false))
       (= new_pc1 (store pc1 |fml:t| true))
       (= new_m (store m |fml:t| |0:ticket|))
       (= pc2 new_pc2)
       (= next_ticket new_next_ticket)
       (select pc3 |fml:t|)
       (|<:ticket:ticket| |__new_fml:x| |__fml:y|)
       a!1)))
(or step12 step23 step31)
(or (not step12) (not step23))
(or (not step12) (not step31))
(or (not step23) (not step31))) :trans true))
(define-fun property () Bool (! (forall ((|T1:thread| thread) (|T2:thread| thread))
  (=> (and (select pc3 |T1:thread|) (select pc3 |T2:thread|))
      (= |T1:thread| |T2:thread|))) :invar-property 0))
(assert (forall ((|T:ticket| ticket) (|U:ticket| ticket) (|V:ticket| ticket))
  (or (not (and (|<:ticket:ticket| |T:ticket| |U:ticket|)
                (|<:ticket:ticket| |U:ticket| |V:ticket|)))
      (|<:ticket:ticket| |T:ticket| |V:ticket|))))
(assert (forall ((|T:ticket| ticket) (|U:ticket| ticket))
  (not (and (|<:ticket:ticket| |T:ticket| |U:ticket|)
            (|<:ticket:ticket| |U:ticket| |T:ticket|)))))
(assert (forall ((|T:ticket| ticket) (|U:ticket| ticket))
  (or (|<:ticket:ticket| |T:ticket| |U:ticket|)
      (= |T:ticket| |U:ticket|)
      (|<:ticket:ticket| |U:ticket| |T:ticket|))))
(assert (forall ((|X:ticket| ticket))
  (or (= |0:ticket| |X:ticket|) (|<:ticket:ticket| |0:ticket| |X:ticket|))))