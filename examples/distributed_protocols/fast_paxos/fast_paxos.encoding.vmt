(assert (forall ((|R:round| round)) (not (|<:round:round| |R:round| |0:round|))))
(assert (forall ((|Q1:c_quorum| c_quorum) (|Q2:c_quorum| c_quorum))
  (exists ((|N:node| node))
    (and (c_member |N:node| |Q1:c_quorum|) (c_member |N:node| |Q2:c_quorum|)))))
(assert (forall ((|Q1:c_quorum| c_quorum)
         (|Q2:f_quorum| f_quorum)
         (|Q3:f_quorum| f_quorum))
  (exists ((|N:node| node))
    (and (c_member |N:node| |Q1:c_quorum|)
         (f_member |N:node| |Q2:f_quorum|)
         (f_member |N:node| |Q3:f_quorum|)))))