(declare-sort node 0)
(declare-sort quorum 0)
(declare-sort value 0)
(declare-fun votes () (Array node (Array node Bool)))
(declare-fun new_decided () (Array node (Array value Bool)))
(declare-fun leader () (Array node Bool))
(declare-fun new_voted () (Array node Bool))
(declare-fun new_vote_msg () (Array node (Array node Bool)))
(declare-fun vote_msg () (Array node (Array node Bool)))
(declare-fun |__fml:sender| () node)
(declare-fun |__fml:src| () node)
(declare-fun voted () (Array node Bool))
(declare-fun new_vote_request_msg () (Array node (Array node Bool)))
(declare-fun new_leader () (Array node Bool))
(declare-fun |__fml:q| () quorum)
(declare-fun vote_request_msg () (Array node (Array node Bool)))
(declare-fun |__fml:dst| () node)
(declare-fun decided () (Array node (Array value Bool)))
(declare-fun |__fml:v| () value)
(declare-fun |__fml:n| () node)
(declare-fun member (node quorum) Bool)
(declare-fun new_votes () (Array node (Array node Bool)))
(define-fun .decided () (Array node (Array value Bool)) (! decided :next new_decided))
(define-fun .voted () (Array node Bool) (! voted :next new_voted))
(define-fun .vote_msg () (Array node (Array node Bool)) (! vote_msg :next new_vote_msg))
(declare-fun new___fmlsender () node)
(define-fun .__fmlsender () node (! |__fml:sender| :next new___fmlsender))
(declare-fun new___fmlsrc () node)
(define-fun .__fmlsrc () node (! |__fml:src| :next new___fmlsrc))
(define-fun .vote_request_msg () (Array node (Array node Bool)) (! vote_request_msg :next new_vote_request_msg))
(define-fun .leader () (Array node Bool) (! leader :next new_leader))
(declare-fun new___fmlq () quorum)
(define-fun .__fmlq () quorum (! |__fml:q| :next new___fmlq))
(declare-fun new___fmldst () node)
(define-fun .__fmldst () node (! |__fml:dst| :next new___fmldst))
(declare-fun new___fmlv () value)
(define-fun .__fmlv () value (! |__fml:v| :next new___fmlv))
(declare-fun new___fmln () node)
(define-fun .__fmln () node (! |__fml:n| :next new___fmln))
(define-fun .votes () (Array node (Array node Bool)) (! votes :next new_votes))
(declare-fun become_leader () Bool)
(define-fun .become_leader () Bool (! become_leader :action 0))
(declare-fun decide () Bool)
(define-fun .decide () Bool (! decide :action 0))
(declare-fun recv_vote () Bool)
(define-fun .recv_vote () Bool (! recv_vote :action 0))
(declare-fun send_request_vote () Bool)
(define-fun .send_request_vote () Bool (! send_request_vote :action 0))
(declare-fun send_vote () Bool)
(define-fun .send_vote () Bool (! send_vote :action 0))
(declare-fun send_vote_mark_false () Bool)
(define-fun .send_vote_mark_false () Bool (! send_vote_mark_false :action 0))
(define-fun init () Bool (! (let ((a!1 (lambda ((|N1:node| node)) (lambda ((|N2:node| node)) false))))
  (and (= vote_request_msg a!1)
       (= voted (lambda ((|N:node| node)) false))
       (= vote_msg a!1)
       (= votes a!1)
       (= leader (lambda ((|N1:node| node)) false))
       (= decided (lambda ((|N:node| node)) (lambda ((|V:value| value)) false))))) :init true))
(define-fun trans () Bool (! (and (=> become_leader (let ((a!1 (forall ((|N:node| node))
             (or (not (member |N:node| |__fml:q|))
                 (select (select votes |__fml:n|) |N:node|)))))
  (and (= new_leader (store leader |__fml:n| true))
       (= decided new_decided)
       (= votes new_votes)
       (= vote_request_msg new_vote_request_msg)
       (= voted new_voted)
       (= vote_msg new_vote_msg)
       a!1)))
(=> decide (let ((a!1 (= new_decided
              (store decided
                     |__fml:n|
                     (store (select decided |__fml:n|) |__fml:v| true))))
      (a!2 (forall ((|V:value| value))
             (not (select (select decided |__fml:n|) |V:value|)))))
  (and a!1
       (= leader new_leader)
       (= votes new_votes)
       (= vote_request_msg new_vote_request_msg)
       (= voted new_voted)
       (= vote_msg new_vote_msg)
       (select leader |__fml:n|)
       a!2)))
(=> recv_vote (let ((a!1 (= new_votes
              (store votes
                     |__fml:n|
                     (store (select votes |__fml:n|) |__fml:sender| true)))))
  (and a!1
       (= leader new_leader)
       (= decided new_decided)
       (= vote_request_msg new_vote_request_msg)
       (= voted new_voted)
       (= vote_msg new_vote_msg)
       (select (select vote_msg |__fml:sender|) |__fml:n|))))
(=> send_request_vote (let ((a!1 (= new_vote_request_msg
              (store vote_request_msg
                     |__fml:src|
                     (store (select vote_request_msg |__fml:src|)
                            |__fml:dst|
                            true)))))
  (and a!1
       (= leader new_leader)
       (= decided new_decided)
       (= votes new_votes)
       (= voted new_voted)
       (= vote_msg new_vote_msg))))
(=> send_vote (let ((a!1 (= new_vote_msg
              (store vote_msg
                     |__fml:src|
                     (store (select vote_msg |__fml:src|) |__fml:dst| true)))))
  (and a!1
       (= new_voted (store voted |__fml:src| true))
       (= leader new_leader)
       (= decided new_decided)
       (= votes new_votes)
       (= vote_request_msg new_vote_request_msg)
       (not (select voted |__fml:src|))
       (select (select vote_request_msg |__fml:dst|) |__fml:src|))))
(=> send_vote_mark_false (let ((a!1 (= new_vote_msg
              (store vote_msg
                     |__fml:src|
                     (store (select vote_msg |__fml:src|) |__fml:dst| true))))
      (a!2 (= new_vote_request_msg
              (store vote_request_msg
                     |__fml:dst|
                     (store (select vote_request_msg |__fml:dst|)
                            |__fml:src|
                            false)))))
  (and a!1
       (= new_voted (store voted |__fml:src| true))
       a!2
       (= leader new_leader)
       (= decided new_decided)
       (= votes new_votes)
       (not (select voted |__fml:src|))
       (select (select vote_request_msg |__fml:dst|) |__fml:src|))))
(or become_leader decide recv_vote send_request_vote send_vote send_vote_mark_false)
(or (not become_leader) (not decide))
(or (not become_leader) (not recv_vote))
(or (not become_leader) (not send_request_vote))
(or (not become_leader) (not send_vote))
(or (not become_leader) (not send_vote_mark_false))
(or (not decide) (not recv_vote))
(or (not decide) (not send_request_vote))
(or (not decide) (not send_vote))
(or (not decide) (not send_vote_mark_false))
(or (not recv_vote) (not send_request_vote))
(or (not recv_vote) (not send_vote))
(or (not recv_vote) (not send_vote_mark_false))
(or (not send_request_vote) (not send_vote))
(or (not send_request_vote) (not send_vote_mark_false))
(or (not send_vote) (not send_vote_mark_false))) :trans true))
(define-fun property () Bool (! (forall ((|N1:node| node)
         (|N2:node| node)
         (|V1:value| value)
         (|V2:value| value))
  (=> (and (select (select decided |N1:node|) |V1:value|)
           (select (select decided |N2:node|) |V2:value|))
      (= |V1:value| |V2:value|))) :invar-property 0))
(assert (forall ((|Q1:quorum| quorum) (|Q2:quorum| quorum))
  (exists ((|N:node| node))
    (and (member |N:node| |Q1:quorum|) (member |N:node| |Q2:quorum|)))))