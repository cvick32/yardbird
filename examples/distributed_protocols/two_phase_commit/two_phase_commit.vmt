(declare-fun alive () (Array node Bool))
(declare-fun decide_abort () (Array node Bool))
(declare-fun vote_no () (Array node Bool))
(declare-fun new_go_abort () (Array node Bool))
(declare-fun abort_flag () Bool)
(declare-fun decide_commit () (Array node Bool))
(define-fun .decide_abort () (Array node Bool) (! decide_abort :next new_decide_abort))
(define-fun .vote_no () (Array node Bool) (! vote_no :next new_vote_no))
(declare-fun new___sk__N () node)
(define-fun .__sk__N () node (! __sk__N :next new___sk__N))
(define-fun .decide_commit () (Array node Bool) (! decide_commit :next new_decide_commit))
(define-fun .abort_flag () Bool (! abort_flag :next new_abort_flag))
(define-fun .alive () (Array node Bool) (! alive :next new_alive))
(declare-fun new___fmln () node)
(define-fun .__fmln () node (! |__fml:n| :next new___fmln))
(define-fun .go_commit () (Array node Bool) (! go_commit :next new_go_commit))
(define-fun .vote_yes () (Array node Bool) (! vote_yes :next new_vote_yes))
(define-fun .go_abort () (Array node Bool) (! go_abort :next new_go_abort))
(declare-fun abort () Bool)
(define-fun .abort () Bool (! abort :action 0))
(declare-fun commit () Bool)
(define-fun .commit () Bool (! commit :action 0))
(declare-fun fail () Bool)
(define-fun .fail () Bool (! fail :action 0))
(declare-fun go1 () Bool)
(define-fun .go1 () Bool (! go1 :action 0))
(declare-fun go2 () Bool)
(define-fun .go2 () Bool (! go2 :action 0))
(declare-fun vote1 () Bool)
(define-fun .vote1 () Bool (! vote1 :action 0))
(declare-fun vote2 () Bool)
(define-fun .vote2 () Bool (! vote2 :action 0))
(define-fun init () Bool (! (let ((a!1 (lambda ((|N:node| node)) false)))
  (and (= vote_yes a!1)
       (= vote_no a!1)
       (= alive (lambda ((|N:node| node)) true))
       (= go_commit a!1)
       (= go_abort a!1)
       (= decide_commit a!1)
       (= decide_abort a!1)
       (not abort_flag))) :init true))
(define-fun trans () Bool (! (and (=> abort (and (= new_decide_abort (store decide_abort |__fml:n| true))
     (= decide_commit new_decide_commit)
     (= abort_flag new_abort_flag)
     (= alive new_alive)
     (= go_commit new_go_commit)
     (= go_abort new_go_abort)
     (= vote_yes new_vote_yes)
     (= vote_no new_vote_no)
     (select alive |__fml:n|)
     (select go_abort |__fml:n|)))
(=> commit (and (= new_decide_commit (store decide_commit |__fml:n| true))
     (= decide_abort new_decide_abort)
     (= abort_flag new_abort_flag)
     (= alive new_alive)
     (= go_commit new_go_commit)
     (= go_abort new_go_abort)
     (= vote_yes new_vote_yes)
     (= vote_no new_vote_no)
     (select alive |__fml:n|)
     (select go_commit |__fml:n|)))
(=> fail (and (= new_alive (store alive |__fml:n| false))
     new_abort_flag
     (= decide_abort new_decide_abort)
     (= decide_commit new_decide_commit)
     (= go_commit new_go_commit)
     (= go_abort new_go_abort)
     (= vote_yes new_vote_yes)
     (= vote_no new_vote_no)
     (select alive |__fml:n|)))
(=> go1 (and (= new_go_commit (lambda ((|N:node| node)) true))
     (= decide_abort new_decide_abort)
     (= decide_commit new_decide_commit)
     (= abort_flag new_abort_flag)
     (= alive new_alive)
     (= go_abort new_go_abort)
     (= vote_yes new_vote_yes)
     (= vote_no new_vote_no)
     (forall ((|N:node| node)) (not (select go_commit |N:node|)))
     (forall ((|N:node| node)) (not (select go_abort |N:node|)))
     (forall ((|N:node| node)) (select vote_yes |N:node|))))
(=> go2 (and (= new_go_abort (lambda ((|N:node| node)) true))
     (= decide_abort new_decide_abort)
     (= decide_commit new_decide_commit)
     (= abort_flag new_abort_flag)
     (= alive new_alive)
     (= go_commit new_go_commit)
     (= vote_yes new_vote_yes)
     (= vote_no new_vote_no)
     (forall ((|N:node| node)) (not (select go_commit |N:node|)))
     (forall ((|N:node| node)) (not (select go_abort |N:node|)))
     (or (select vote_no __sk__N) (not (select alive __sk__N)))))
(=> vote1 (and (= new_vote_yes (store vote_yes |__fml:n| true))
     (= decide_abort new_decide_abort)
     (= decide_commit new_decide_commit)
     (= abort_flag new_abort_flag)
     (= alive new_alive)
     (= go_commit new_go_commit)
     (= go_abort new_go_abort)
     (= vote_no new_vote_no)
     (select alive |__fml:n|)
     (not (select vote_no |__fml:n|))
     (not (select decide_commit |__fml:n|))
     (not (select decide_abort |__fml:n|))))
(=> vote2 (and (= new_vote_no (store vote_no |__fml:n| true))
     new_abort_flag
     (= new_decide_abort (store decide_abort |__fml:n| true))
     (= decide_commit new_decide_commit)
     (= alive new_alive)
     (= go_commit new_go_commit)
     (= go_abort new_go_abort)
     (= vote_yes new_vote_yes)
     (select alive |__fml:n|)
     (not (select vote_yes |__fml:n|))
     (not (select decide_commit |__fml:n|))
     (not (select decide_abort |__fml:n|))))
(or abort commit fail go1 go2 vote1 vote2)
(or (not abort) (not commit))
(or (not abort) (not fail))
(or (not abort) (not go1))
(or (not abort) (not go2))
(or (not abort) (not vote1))
(or (not abort) (not vote2))
(or (not commit) (not fail))
(or (not commit) (not go1))
(or (not commit) (not go2))
(or (not commit) (not vote1))
(or (not commit) (not vote2))
(or (not fail) (not go1))
(or (not fail) (not go2))
(or (not fail) (not vote1))
(or (not fail) (not vote2))
(or (not go1) (not go2))
(or (not go1) (not vote1))
(or (not go1) (not vote2))
(or (not go2) (not vote1))
(or (not go2) (not vote2))
(or (not vote1) (not vote2))) :trans true))
(define-fun property () Bool (! (forall ((|N0:node| node) (|N1:node| node))
  (and (=> (select decide_commit |N0:node|)
           (not (select decide_abort |N1:node|)))
       (=> (select decide_commit |N0:node|) (select vote_yes |N1:node|))
       (=> (select decide_abort |N0:node|) abort_flag))) :invar-property 0))