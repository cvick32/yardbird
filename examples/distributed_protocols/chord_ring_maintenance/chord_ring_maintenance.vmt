(or (not notify) (not remove_org))
(or (not notify) (not stabilize))
(or (not notify) (not test))
(or (not reach_org) (not remove))
(or (not reach_org) (not remove_org))
(or (not reach_org) (not stabilize))
(or (not reach_org) (not test))
(or (not remove) (not remove_org))
(or (not remove) (not stabilize))
(or (not remove) (not test))
(or (not remove_org) (not stabilize))
(or (not remove_org) (not test))
(or (not stabilize) (not test))) :trans true))
(define-fun property () Bool (! (forall ((|N:node| node)) (not (select error |N:node|))) :invar-property 0))
(define-fun property () Bool (! (forall ((|X:node| node) (|Y:node| node) (|Z:node| node))
  (=> (and (select (select s1 |X:node|) |Y:node|)
           (select (select s1 |X:node|) |Z:node|))
      (= |Y:node| |Z:node|))) :invar-property 1))
(define-fun property () Bool (! (forall ((|X:node| node) (|Y:node| node) (|Z:node| node))
  (=> (and (select (select s2 |X:node|) |Y:node|)
           (select (select s2 |X:node|) |Z:node|))
      (= |Y:node| |Z:node|))) :invar-property 2))
(define-fun property () Bool (! (forall ((|X:node| node) (|Y:node| node) (|Z:node| node))
  (=> (and (select (select p |X:node|) |Y:node|)
           (select (select p |X:node|) |Z:node|))
      (= |Y:node| |Z:node|))) :invar-property 3))
(assert (forall ((|W:node| node) (|X:node| node) (|Y:node| node) (|Z:node| node))
  (or (not (and (ring.btw |W:node| |X:node| |Y:node|)
                (ring.btw |W:node| |Y:node| |Z:node|)))
      (ring.btw |W:node| |X:node| |Z:node|))))
(assert (forall ((|W:node| node) (|X:node| node) (|Y:node| node))
  (or (not (ring.btw |W:node| |X:node| |Y:node|))
      (not (ring.btw |W:node| |Y:node| |X:node|)))))
(assert (forall ((|W:node| node) (|X:node| node) (|Y:node| node))
  (or (ring.btw |W:node| |X:node| |Y:node|)
      (ring.btw |W:node| |Y:node| |X:node|)
      (= |W:node| |X:node|)
      (= |X:node| |Y:node|))))
(assert (forall ((|X:node| node) (|Y:node| node) (|Z:node| node))
  (let ((a!1 (not (and (ring.btw |X:node| |Y:node| |Z:node|)
                       (not (= |X:node| |Z:node|))))))
    (or a!1 (ring.btw |Y:node| |Z:node| |X:node|)))))
(assert (not (= other org)))