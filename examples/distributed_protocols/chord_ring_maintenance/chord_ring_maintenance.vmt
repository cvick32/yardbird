(define-fun init () Bool (! (let ((a!1 (lambda ((|X:node| node)) (or (= |X:node| org) (= |X:node| other))))
      (a!2 (lambda ((|X:node| node))
             (lambda ((|Y:node| node))
               (or (and (= |X:node| org) (= |Y:node| other))
                   (and (= |X:node| other) (= |Y:node| org))))))
      (a!3 (lambda ((|X:node| node)) false)))
  (and (= a a!1)
       (= s1 a!2)
       (= in_s1 a!1)
       (= s2 (lambda ((|X:node| node)) (lambda ((|Y:node| node)) false)))
       (= in_s2 a!3)
       (= p a!2)
       (= reach (lambda ((|X:node| node)) (= |X:node| org)))
       (= error a!3))) :init true))
(define-fun trans () Bool (! (and (=> fail (let ((a!1 (lambda ((|Y:node| node)) false))
      (a!2 (forall ((|Y:node| node))
             (or (not (select (select s1 |Y:node|) |__fml:x|))
                 (select in_s2 |Y:node|))))
      (a!3 (forall ((|Y:node| node) (|X:node| node))
             (let ((a!1 (not (and (select (select s1 |X:node|) |Y:node|)
                                  (select (select s2 |X:node|) |__fml:x|)))))
               (or a!1 (and (not (= |Y:node| |__fml:x|)) (select a |Y:node|)))))))
  (and (= new_a (store a |__fml:x| false))
       (= new_p (store p |__fml:x| a!1))
       (= new_s1 (store s1 |__fml:x| a!1))
       (= new_in_s1 (store in_s1 |__fml:x| false))
       (= new_s2 (store s2 |__fml:x| a!1))
       (= new_in_s2 (store in_s2 |__fml:x| false))
       (= reach new_reach)
       (= error new_error)
       (select a |__fml:x|)
       (not (= |__fml:x| org))
       a!2
       (forall ((|Y:node| node) (|Z:node| node))
         (let ((a!1 (not (and (select (select s1 |Y:node|) |__fml:x|)
                              (select (select s2 |Y:node|) |Z:node|)))))
           (or a!1 (select a |Z:node|))))
       a!3)))
(=> inherit (let ((a!1 (= new_s2
              (store s2
                     |__fml:x|
                     (lambda ((|Z:node| node)) (= |Z:node| |__fml:z|))))))
  (and a!1
       (= new_in_s2 (store in_s2 |__fml:x| true))
       (= a new_a)
       (= s1 new_s1)
       (= in_s1 new_in_s1)
       (= p new_p)
       (= reach new_reach)
       (= error new_error)
       (select a |__fml:x|)
       (select (select s1 |__fml:x|) |__fml:y|)
       (select a |__fml:y|)
       (select (select s1 |__fml:y|) |__fml:z|))))
(=> join (let ((a!1 (= new_s1
              (store s1
                     |__fml:x|
                     (lambda ((|Y:node| node)) (= |__fml:y| |Y:node|)))))
      (a!2 (lambda ((|Y:node| node)) false)))
  (and (= new_a (store a |__fml:x| true))
       a!1
       (= new_in_s1 (store in_s1 |__fml:x| true))
       (= new_s2 (store s2 |__fml:x| a!2))
       (= new_in_s2 (store in_s2 |__fml:x| false))
       (= new_p (store p |__fml:x| a!2))
       (= reach new_reach)
       (= error new_error)
       (not (select a |__fml:x|))
       (select a |__fml:y|)
       (not (ring.btw |__fml:x| org |__fml:y|)))))
(=> notify (let ((a!1 (= new_p
              (store p
                     |__fml:y|
                     (lambda ((|X:node| node)) (= |X:node| |__fml:x|)))))
      (a!2 (forall ((|X:node| node))
             (or (select (select p |__fml:y|) |__fml:z|)
                 (not (select (select p |__fml:y|) |X:node|))))))
  (and a!1
       (= a new_a)
       (= s1 new_s1)
       (= s2 new_s2)
       (= in_s1 new_in_s1)
       (= in_s2 new_in_s2)
       (= reach new_reach)
       (= error new_error)
       (select a |__fml:x|)
       (select (select s1 |__fml:x|) |__fml:y|)
       (select a |__fml:y|)
       a!2
       (ring.btw |__fml:z| |__fml:x| |__fml:y|))))
(=> reach_org (let ((a!1 (or (and (select (select s1 |__fml:x|) |__fml:y|)
                    (select a |__fml:y|)
                    (select reach |__fml:y|))
               (and (select (select s1 |__fml:x|) |__fml:y|)
                    (not (select a |__fml:y|))
                    (select (select s2 |__fml:x|) |__fml:z|)
                    (select a |__fml:z|)
                    (select reach |__fml:z|)))))
  (and (= new_reach (store reach |__fml:x| true))
       (= a new_a)
       (= s1 new_s1)
       (= s2 new_s2)
       (= in_s1 new_in_s1)
       (= in_s2 new_in_s2)
       (= p new_p)
       (= error new_error)
       a!1)))
(=> remove (let ((a!1 (= new_s1
              (store s1
                     |__fml:x|
                     (lambda ((|Z:node| node)) (= |Z:node| |__fml:z|))))))
  (and a!1
       (= new_in_s1 (store in_s1 |__fml:x| true))
       (= new_s2 (store s2 |__fml:x| (lambda ((|Y:node| node)) false)))
       (= new_in_s2 (store in_s2 |__fml:x| false))
       (= a new_a)
       (= p new_p)
       (= reach new_reach)
       (= error new_error)
       (select a |__fml:x|)
       (select (select s1 |__fml:x|) |__fml:y|)
       (not (select a |__fml:y|))
       (select (select s2 |__fml:x|) |__fml:z|))))
(=> remove_org (let ((a!1 (forall ((|Z:node| node))
             (or (select a |__fml:y|)
                 (not (select (select s2 |__fml:x|) |Z:node|))
                 (select (select s2 |__fml:x|) |__fml:z|))))
      (a!2 (not (and (not (select a |__fml:y|))
                     (select (select s2 |__fml:x|) |__fml:z|)))))
  (and (= new_reach (store reach |__fml:x| false))
       (= a new_a)
       (= s1 new_s1)
       (= s2 new_s2)
       (= in_s1 new_in_s1)
       (= in_s2 new_in_s2)
       (= p new_p)
       (= error new_error)
       (not (= |__fml:x| org))
       (select (select s1 |__fml:x|) |__fml:y|)
       (or (not (select a |__fml:y|)) (not (select reach |__fml:y|)))
       a!1
       (or a!2 (not (select a |__fml:z|)) (not (select reach |__fml:z|))))))
(=> stabilize (let ((a!1 (= new_s1
              (store s1
                     |__fml:x|
                     (lambda ((|Z:node| node)) (= |Z:node| |__fml:z|)))))
      (a!2 (= new_s2
              (store s2
                     |__fml:x|
                     (lambda ((|Y:node| node)) (= |Y:node| |__fml:y|))))))
  (and a!1
       (= new_in_s1 (store in_s1 |__fml:x| true))
       a!2
       (= new_in_s2 (store in_s2 |__fml:x| true))
       (= a new_a)
       (= p new_p)
       (= reach new_reach)
       (= error new_error)
       (select a |__fml:x|)
       (select (select s1 |__fml:x|) |__fml:y|)
       (select a |__fml:y|)
       (select (select p |__fml:y|) |__fml:z|)
       (ring.btw |__fml:x| |__fml:z| |__fml:y|))))
(=> test (let ((a!1 (forall ((|Y:node| node))
             (or (not (and (ring.btw |__fml:x| |Y:node| org)
                           (select a |Y:node|)))
                 (select reach |Y:node|))))
      (a!2 (or (not (select in_s1 |__fml:x|))
               (exists ((|Y:node| node))
                 (select (select s1 |__fml:x|) |Y:node|))))
      (a!3 (or (not (select in_s2 |__fml:x|))
               (exists ((|Y:node| node))
                 (select (select s2 |__fml:x|) |Y:node|)))))
  (and (= new_error (store error |__fml:x| true))
       (= a new_a)
       (= s1 new_s1)
       (= s2 new_s2)
       (= in_s1 new_in_s1)
       (= in_s2 new_in_s2)
       (= p new_p)
       (= reach new_reach)
       (forall ((|Y:node| node) (|X:node| node))
         (let ((a!1 (not (and (select (select s1 |X:node|) |Y:node|)
                              (select a |Y:node|)
                              (select reach |Y:node|)))))
           (or a!1 (select reach |X:node|))))
       (forall ((|Y:node| node) (|Z:node| node) (|X:node| node))
         (let ((a!1 (not (and (select (select s1 |X:node|) |Y:node|)
                              (not (select a |Y:node|))
                              (select (select s2 |X:node|) |Z:node|)
                              (select a |Z:node|)
                              (select reach |Z:node|)))))
           (or a!1 (select reach |X:node|))))
       a!1
       (select a |__fml:x|)
       (not (select reach |__fml:x|))
       a!2
       a!3)))
(or fail inherit join notify reach_org remove remove_org stabilize test)
(or (not fail) (not inherit))
(or (not fail) (not join))
(or (not fail) (not notify))
(or (not fail) (not reach_org))
(or (not fail) (not remove))
(or (not fail) (not remove_org))
(or (not fail) (not stabilize))
(or (not fail) (not test))
(or (not inherit) (not join))
