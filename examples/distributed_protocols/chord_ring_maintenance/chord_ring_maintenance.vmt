(define-fun .p () (Array node (Array node Bool)) (! p :next new_p))
(define-fun .a () (Array node Bool) (! a :next new_a))
(define-fun .reach () (Array node Bool) (! reach :next new_reach))
(define-fun .error () (Array node Bool) (! error :next new_error))
(define-fun .s2 () (Array node (Array node Bool)) (! s2 :next new_s2))
