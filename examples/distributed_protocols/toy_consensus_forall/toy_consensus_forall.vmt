(declare-sort node 0)
(declare-sort quorum 0)
(declare-sort value 0)
(declare-fun voted () (Array node Bool))
(declare-fun new_vote () (Array node (Array value Bool)))
(declare-fun member (node quorum) Bool)
(declare-fun vote () (Array node (Array value Bool)))
(declare-fun |__fml:v| () value)
(declare-fun |__fml:n| () node)
(declare-fun new_decided () (Array value Bool))
(declare-fun |__fml:q| () quorum)
(declare-fun decided () (Array value Bool))
(declare-fun new_voted () (Array node Bool))
(define-fun .vote () (Array node (Array value Bool)) (! vote :next new_vote))
(declare-fun new___fmlv () value)
(define-fun .__fmlv () value (! |__fml:v| :next new___fmlv))
(declare-fun new___fmln () node)
(define-fun .__fmln () node (! |__fml:n| :next new___fmln))
(define-fun .decided () (Array value Bool) (! decided :next new_decided))
(declare-fun new___fmlq () quorum)
(define-fun .__fmlq () quorum (! |__fml:q| :next new___fmlq))
(define-fun .voted () (Array node Bool) (! voted :next new_voted))
(declare-fun cast_vote () Bool)
(define-fun .cast_vote () Bool (! cast_vote :action 0))
(declare-fun decide () Bool)
(define-fun .decide () Bool (! decide :action 0))
(define-fun init () Bool (! (let ((a!1 (lambda ((|V:value| value)) false)))
  (and (= voted (lambda ((|N:node| node)) false))
       (= vote (lambda ((|N:node| node)) (lambda ((|V:value| value)) false)))
       (= decided a!1))) :init true))
(define-fun trans () Bool (! (and (=> cast_vote (let ((a!1 (= new_vote
              (store vote
                     |__fml:n|
                     (store (select vote |__fml:n|) |__fml:v| true)))))
  (and a!1
       (= new_voted (store voted |__fml:n| true))
       (= decided new_decided)
       (not (select voted |__fml:n|)))))
(=> decide (let ((a!1 (forall ((|N:node| node))
             (or (not (member |N:node| |__fml:q|))
                 (select (select vote |N:node|) |__fml:v|)))))
  (and (= new_decided (store decided |__fml:v| true))
       (= voted new_voted)
       (= vote new_vote)
       a!1)))
(or cast_vote decide)
(or (not cast_vote) (not decide))) :trans true))
(define-fun property () Bool (! (forall ((|V1:value| value) (|V2:value| value))
  (=> (and (select decided |V1:value|) (select decided |V2:value|))
      (= |V1:value| |V2:value|))) :invar-property 0))
(assert (forall ((|Q1:quorum| quorum) (|Q2:quorum| quorum))
  (exists ((|N:node| node))
    (and (member |N:node| |Q1:quorum|) (member |N:node| |Q2:quorum|)))))